---
import MinimalLayout from '../layouts/MinimalLayout.astro';
---

<MinimalLayout title="Suchintha Hettiarachchi">
  
  <!-- Quick Black Loader Screen -->
  <div class="page-loader" id="pageLoader"></div>

  <main class="home-container">
    
    <!-- Subtle Color Ambient Glow -->
    <div class="home-ambient"></div>

    <div class="home-content">
      <p class="home-tag code-font load-anim" style="--d: 0.2s">// PORTFOLIO</p>
      
      <h1 class="mega-name">
        <span class="name-first load-anim" style="--d: 0.5s">SUCHINTHA</span><br/>
        <span class="name-last load-anim" style="--d: 0.8s">HETTIARACHCHI</span>
      </h1>
      
      <p class="home-role load-anim" style="--d: 1.1s">DEVELOPER & FILMMAKER</p>
    </div>

    <div class="home-links">
      <a href="/stack" class="home-link stack-link load-anim" style="--d: 1.4s">
        <span class="link-number code-font">01</span>
        <span class="link-text">Enter Stack</span>
        <span class="link-arrow">→</span>
      </a>
      
      <a href="/frame" class="home-link frame-link load-anim" style="--d: 1.6s">
        <span class="link-number code-font">02</span>
        <span class="link-text">Enter Frame</span>
        <span class="link-arrow">→</span>
      </a>

      <a href="/contact" class="home-link contact-link load-anim" style="--d: 1.8s">
        <span class="link-number code-font">03</span>
        <span class="link-text">Contact</span>
        <span class="link-arrow">→</span>
      </a>
    </div>

  </main>
</MinimalLayout>

<style>
  /* ── LOADER SCREEN ── */
  .page-loader {
    position: fixed;
    inset: 0;
    background: #000000;
    z-index: 999;
    pointer-events: none;
    animation: loaderFade 0.6s 0.3s forwards;
  }
  @keyframes loaderFade {
    to { opacity: 0; visibility: hidden; }
  }

  /* ── LAYOUT ── */
  .home-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 15vh 6vw 5vh 6vw;
    position: relative;
    overflow: hidden;
  }

  .home-ambient {
    position: absolute;
    top: 20%;
    left: 40%;
    width: 40vw;
    height: 40vw;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.04) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
  }

  .home-content {
    position: relative;
    z-index: 1;
  }

  .home-tag {
    font-size: 0.8rem;
    color: #444444;
    letter-spacing: 0.2em;
    margin-bottom: 2rem;
  }

  .mega-name {
    font-size: clamp(4rem, 12vw, 12rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
  }

  .name-first {
    color: #ffffff;
    display: block;
  }

  .name-last {
    -webkit-text-stroke: 2px #c9a84c; 
    color: transparent;
    display: block;
    text-shadow: 0 0 60px rgba(201, 168, 76, 0.1);
  }

  .home-role {
    font-size: 1rem;
    color: #555555;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  /* ── STAGGERED LOAD ANIMATION ── */
  .load-anim {
    /* Starts hidden and pushed down */
    opacity: 0;
    transform: translateY(40px);
    /* Uses the --d variable for delay, set in the HTML */
    animation: smoothReveal 1s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards;
  }

  @keyframes smoothReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── MENU LINKS ── */
  .home-links {
    margin-top: 8rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 400px;
    position: relative;
    z-index: 1;
  }

  .home-link {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
    color: #ffffff;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #1a1a1a;
    transition: all 0.3s ease;
  }

  .link-number {
    font-size: 0.7rem;
    color: #333333;
    transition: color 0.3s ease;
  }

  .link-text {
    font-size: 1.5rem;
    font-weight: 700;
    flex: 1;
    transition: all 0.3s ease;
  }

  .link-arrow {
    font-size: 1.5rem;
    color: #333333;
    transition: all 0.3s ease;
  }

  /* Stack Hover (Teal) */
  .home-link.stack-link:hover {
    padding-left: 1rem;
    border-bottom-color: #2d8a8a;
  }
  .home-link.stack-link:hover .link-arrow { transform: translateX(5px); color: #2d8a8a; }
  .home-link.stack-link:hover .link-text { color: #2d8a8a; }
  .home-link.stack-link:hover .link-number { color: #2d8a8a; }

  /* Frame Hover (Amber) */
  .home-link.frame-link:hover {
    padding-left: 1rem;
    border-bottom-color: #c9a84c;
  }
  .home-link.frame-link:hover .link-arrow { transform: translateX(5px); color: #c9a84c; }
  .home-link.frame-link:hover .link-text { color: #c9a84c; }
  .home-link.frame-link:hover .link-number { color: #c9a84c; }

  /* Contact Hover (Green) */
  .home-link.contact-link:hover {
    padding-left: 1rem;
    border-bottom-color: #00ff66;
  }
  .home-link.contact-link:hover .link-arrow { transform: translateX(5px); color: #00ff66; }
  .home-link.contact-link:hover .link-text { color: #00ff66; }
  .home-link.contact-link:hover .link-number { color: #00ff66; }
</style>
