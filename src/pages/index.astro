</body><script>
  // @ts-nocheck
  document.body.style.overflow = 'hidden';
  var loader = document.getElementById('loader');
  var fill = document.getElementById('loaderFill');
  var pct = document.getElementById('loaderPct');
  var count = 0;
  var loaderInterval = setInterval(function() {
    count += Math.floor(Math.random() * 3) + 1;
    if (count > 100) count = 100;
    fill.style.width = count + '%';
    pct.textContent = String(count).padStart(3, '0') + '%';
    if (count >= 100) {
      clearInterval(loaderInterval);
      setTimeout(function() {
        loader.classList.add('out');
        document.body.style.overflow = '';
        setTimeout(function() { loader.style.display = 'none'; }, 800);
      }, 400);
    }
  }, 25);

  var cDot = document.getElementById('cDot');
  var cRing = document.getElementById('cRing');
  var mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', function(e) {
    mx = e.clientX; my = e.clientY;
    cDot.style.left = mx - 3 + 'px';
    cDot.style.top = my - 3 + 'px';
  });
  (function ringLoop() {
    rx += (mx - rx) * 0.1; ry += (my - ry) * 0.1;
    cRing.style.left = rx - 17 + 'px';
    cRing.style.top = ry - 17 + 'px';
    requestAnimationFrame(ringLoop);
  })();
  document.querySelectorAll('a, .work-thumb, .hud-snd').forEach(function(el) {
    el.addEventListener('mouseenter', function() { cRing.classList.add('h'); });
    el.addEventListener('mouseleave', function() { cRing.classList.remove('h'); });
  });

  var lbT = document.getElementById('lbT');
  var lbB = document.getElementById('lbB');
  var heroEl = document.getElementById('hero');
  window.addEventListener('scroll', function() {
    var s = window.scrollY;
    var h = heroEl.offsetHeight;
    var op = Math.max(0, 1 - s / (h * 0.4));
    lbT.style.opacity = op;
    lbB.style.opacity = op;
    document.getElementById('nav').classList.toggle('scrolled', s > 60);
  }, { passive: true });

  var canvas = document.getElementById('dustCanvas');
  var ctx = canvas.getContext('2d');
  var particles = [];
  function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  var dustColors = [[122,139,106],[196,149,106],[140,128,116],[158,107,74]];
  for (var i = 0; i < 60; i++) {
    var big = Math.random() < 0.08;
    var col = dustColors[Math.floor(Math.random() * dustColors.length)];
    particles.push({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      r: big ? (Math.random() * 1.8 + 1) : (Math.random() * 0.9 + 0.2),
      vy: -(Math.random() * 0.12 + 0.03),
      vx: (Math.random() - 0.5) * 0.06,
      a: big ? (Math.random() * 0.2 + 0.1) : (Math.random() * 0.15 + 0.05),
      ph: Math.random() * Math.PI * 2,
      col: col
    });
  }
  function drawDust() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    var t = Date.now() * 0.001;
    particles.forEach(function(p) {
      p.x += p.vx + Math.sin(t + p.ph) * 0.04;
      p.y += p.vy;
      if (p.y < -10) { p.y = canvas.height + 10; p.x = Math.random() * canvas.width; }
      if (p.x < -10) p.x = canvas.width + 10;
      if (p.x > canvas.width + 10) p.x = -10;
      ctx.beginPath();
      ctx.arc(p.x, p.y, Math.max(0.1, p.r), 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(' + p.col[0] + ',' + p.col[1] + ',' + p.col[2] + ',' + p.a + ')';
      ctx.fill();
    });
    requestAnimationFrame(drawDust);
  }
  drawDust();

  var lineEl = document.getElementById('lineCount');
  var lineNum = 0;
  setInterval(function() {
    lineNum += Math.floor(Math.random() * 5) + 1;
    lineEl.textContent = String(lineNum).padStart(6, '0');
  }, 1000 / 24);

  var clockEl = document.getElementById('clock');
  var t0 = Date.now();
  (function tick() {
    var d = Date.now() - t0;
    var h = String(Math.floor(d / 3600000)).padStart(2, '0');
    var m = String(Math.floor((d % 3600000) / 60000)).padStart(2, '0');
    var s = String(Math.floor((d % 60000) / 1000)).padStart(2, '0');
    clockEl.textContent = h + ':' + m + ':' + s;
    requestAnimationFrame(tick);
  })();

  var sndBtn = document.getElementById('sndToggle');
  var sndOn = false;
  sndBtn.addEventListener('click', function() {
    sndOn = !sndOn;
    sndBtn.classList.toggle('on', sndOn);
    sndBtn.querySelector('span').textContent = sndOn ? 'CLEAR' : 'LOGS';
  });

  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('v'); });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.rv, .sdiv').forEach(function(el) { obs.observe(el); });
</script>