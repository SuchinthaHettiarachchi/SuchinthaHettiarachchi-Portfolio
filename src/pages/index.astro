---
import MinimalLayout from '../layouts/MinimalLayout.astro';
---

<MinimalLayout title="Suchintha Hettiarachchi">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400&family=Syne:wght@400;700;800&display=swap" rel="stylesheet" />
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suchintha Hettiarachchi</title>
  <style is:global>
    :root {
      --dark: #f2ede6;
      --surface: #e9e3da;
      --text: #2a2420;
      --muted: #8c8279;
      --teal: #7a8b6a;
      --teal-dim: rgba(122,139,106,0.4);
      --teal-glow: rgba(122,139,106,0.2);
      --amber: #c4956a;
      --amber-dim: rgba(196,149,106,0.3);
      --rust: #9e6b4a;
      --border: #d8d0c6;
      --border-hi: #c8bfb4;
    }
    html { scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: var(--border) var(--dark); }
    body { background: var(--dark); color: var(--text); font-family: 'Syne', sans-serif; overflow-x: hidden; cursor: none; }

    .loader {
      position: fixed; inset: 0; z-index: 9999;
      background: var(--dark);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }
    .loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
    .loader-initials {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 10vw, 8rem);
      letter-spacing: 0.08em;
      color: var(--text);
      margin-bottom: 3rem;
      display: flex;
      gap: 0.02em;
      overflow: hidden;
    }
    .loader-initials span {
      display: inline-block;
      opacity: 0;
      transform: translateY(100%) rotateX(-80deg);
      animation: letterIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .loader-initials span:nth-child(1) { animation-delay: 0.1s; }
    .loader-initials span:nth-child(2) { animation-delay: 0.16s; }
    .loader-initials span:nth-child(3) { animation-delay: 0.22s; }
    .loader-initials span:nth-child(4) { animation-delay: 0.28s; }
    .loader-initials span:nth-child(5) { animation-delay: 0.34s; }
    .loader-initials span:nth-child(6) { animation-delay: 0.4s; }
    .loader-initials span:nth-child(7) { animation-delay: 0.46s; }
    .loader-initials span:nth-child(8) { animation-delay: 0.52s; }
    .loader-initials span:nth-child(9) { animation-delay: 0.58s; }
    @keyframes letterIn {
      0% { opacity: 0; transform: translateY(100%) rotateX(-80deg); }
      60% { opacity: 1; transform: translateY(-5%) rotateX(5deg); }
      100% { opacity: 1; transform: translateY(0) rotateX(0); }
    }
    .loader-track {
      width: clamp(200px, 40vw, 400px);
      height: 1px;
      background: var(--border);
      position: relative;
      overflow: hidden;
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: fadeUp 0.5s 0.6s forwards;
    }
    .loader-fill {
      position: absolute; top: 0; left: 0;
      height: 100%; width: 0%;
      background: var(--text);
      transition: width 0.05s linear;
    }
    .loader-pct {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      color: var(--muted);
      opacity: 0;
      animation: fadeUp 0.5s 0.7s forwards;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .cur-dot { position: fixed; width: 6px; height: 6px; background: var(--teal); border-radius: 50%; pointer-events: none; z-index: 9999; }
    .cur-ring { position: fixed; width: 34px; height: 34px; border: 1px solid var(--teal-dim); border-radius: 50%; pointer-events: none; z-index: 9998; transition: width 0.3s, height 0.3s, border-color 0.3s; will-change: transform; }
    .cur-ring.h { width: 54px; height: 54px; border-color: var(--teal); }

    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 1.8rem 4rem; transition: all 0.4s; }
    nav.scrolled { padding: 1.2rem 4rem; background: rgba(242,237,230,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
    .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: var(--text); text-decoration: none; letter-spacing: 0.2em; }
    .nav-links { display: flex; gap: 2.5rem; }
    .nav-link { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-decoration: none; color: var(--muted); transition: color 0.3s; position: relative; }
    .nav-link.active { color: var(--teal); }
    .nav-link::before { content: ''; position: absolute; top: 50%; left: -0.8rem; width: 2px; height: 0; background: var(--teal); transform: translateY(-50%); transition: height 0.3s; }
    .nav-link.active::before { height: 100%; }
    .nav-link:hover { color: var(--text); }

    .lb { position: fixed; left: 0; right: 0; height: 7vh; background: var(--dark); z-index: 45; pointer-events: none; transition: opacity 0.6s; }
    .lb-t { top: 0; }
    .lb-b { bottom: 0; }

    #hero { position: relative; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .dev-grid-bg { position: absolute; inset: 0; z-index: 0; background-image: linear-gradient(rgba(122,139,106,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(122,139,106,0.1) 1px, transparent 1px); background-size: 40px 40px; transform: perspective(500px) rotateX(60deg) translateY(50px) scale(2); opacity: 0.6; -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%); mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%); }
    .hero-vig { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 50%, transparent 20%, rgba(242,237,230,0.9) 100%); z-index: 1; }
    .hero-grad { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(242,237,230,0.6) 0%, rgba(242,237,230,0) 35%, rgba(242,237,230,0.4) 75%, rgba(242,237,230,1) 100%); z-index: 1; }
    .hero-ambient { position: absolute; top: 30%; left: 45%; width: 50vw; height: 50vw; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(196,149,106,0.06) 0%, transparent 70%); z-index: 1; pointer-events: none; }
    #dustCanvas { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
    .hero-inv { position: absolute; font-family: 'JetBrains Mono', monospace; font-size: clamp(4rem, 12vw, 10rem); letter-spacing: 0.1em; color: rgba(42,36,32,0.025); z-index: 1; pointer-events: none; user-select: none; top: 15%; }

    .hero-content { position: relative; z-index: 4; text-align: center; padding: 2rem; }
    .hero-label { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.5em; color: var(--teal); margin-bottom: 2rem; opacity: 0; transform: translateY(15px); animation: fUp 0.8s 1.8s forwards; }
    .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(5rem, 14vw, 13rem); line-height: 0.85; letter-spacing: 0.02em; margin-bottom: 2rem; opacity: 0; transform: translateY(25px); animation: fUp 1s 2s forwards; }
    .hero-title .l2 { color: var(--teal); position: relative; display: inline-block; }
    .hero-title .l2::after { content: ''; position: absolute; bottom: 0.05em; left: 0; width: 100%; height: 0.08em; background: var(--teal); opacity: 0.3; transform-origin: left; transform: scaleX(0); animation: lnGrow 0.8s 2.6s forwards; }
    @keyframes lnGrow { to { transform: scaleX(1); } }
    .hero-sub { font-size: 0.9rem; color: var(--muted); letter-spacing: 0.2em; margin-bottom: 3rem; opacity: 0; transform: translateY(15px); animation: fUp 0.8s 2.9s forwards; }
    .hero-btn { display: inline-block; padding: 0.85rem 2.8rem; border: 1px solid var(--teal); color: var(--teal); text-decoration: none; font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.3em; position: relative; overflow: hidden; transition: color 0.4s, border-color 0.4s; opacity: 0; transform: translateY(15px); animation: fUp 0.8s 3.1s forwards; }
    .hero-btn::before { content: ''; position: absolute; inset: 0; background: var(--teal); transform: scaleX(0); transform-origin: left; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); z-index: -1; }
    .hero-btn:hover { color: #fff; border-color: var(--teal); }
    .hero-btn:hover::before { transform: scaleX(1); }
    @keyframes fUp { to { opacity: 1; transform: translateY(0); } }

    .hud { position: absolute; z-index: 46; font-family: 'JetBrains Mono', monospace; pointer-events: none; }
    .hud-fr { top: calc(7vh + 1.5rem); right: 4rem; text-align: right; }
    .hud-fr .hl { font-size: 0.45rem; letter-spacing: 0.3em; color: var(--muted); }
    .hud-fr .nm { font-size: 0.8rem; color: var(--teal-dim); letter-spacing: 0.1em; }
    .hud-cl { bottom: calc(7vh + 1.5rem); left: 4rem; }
    .hud-cl .tm { font-size: 0.75rem; color: var(--muted); letter-spacing: 0.15em; }
    .hud-snd { bottom: calc(7vh + 1.5rem); right: 4rem; pointer-events: all; cursor: none; display: flex; align-items: center; gap: 0.5rem; }
    .hud-snd span { font-size: 0.5rem; letter-spacing: 0.3em; color: var(--muted); transition: color 0.3s; }
    .hud-snd .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--muted); transition: background 0.3s; }
    .hud-snd.on .dot { background: var(--teal); }
    .hud-snd.on span { color: var(--teal); }
    .scroll-hint { position: absolute; bottom: calc(7vh + 1.5rem); left: 50%; transform: translateX(-50%); z-index: 46; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
    .scroll-hint span { font-family: 'JetBrains Mono', monospace; font-size: 0.5rem; letter-spacing: 0.4em; color: var(--muted); }
    .scroll-bar { width: 1px; height: 36px; background: var(--border); position: relative; overflow: hidden; }
    .scroll-bar::after { content: ''; position: absolute; top: -100%; left: 0; width: 100%; height: 100%; background: var(--teal); animation: sPulse 2s ease-in-out infinite; }
    @keyframes sPulse { 0% { top: -100%; } 40% { top: 100%; } 100% { top: 100%; } }

    .rv { opacity: 0; transform: translateY(40px); transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
    .rv.v { opacity: 1; transform: translateY(0); }
    .rv-d1 { transition-delay: 0.1s; }
    .rv-d2 { transition-delay: 0.2s; }
    .rv-d3 { transition-delay: 0.3s; }
    .sdiv { height: 1px; background: var(--border); position: relative; overflow: hidden; }
    .sdiv::after { content: ''; position: absolute; top: 0; left: 0; height: 100%; width: 0; background: var(--teal); opacity: 0.4; transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .sdiv.v::after { width: 100%; }
    .sec-glow { position: absolute; border-radius: 50%; pointer-events: none; z-index: 0; filter: blur(80px); }
    .wm { position: absolute; font-family: 'JetBrains Mono', monospace; font-size: clamp(8rem, 16vw, 18rem); color: rgba(42,36,32,0.02); line-height: 1; pointer-events: none; user-select: none; }
    .wm-wk { top: 5rem; right: 4rem; }
    .wm-ct { top: 8rem; right: 4rem; }

    #about { min-height: 100vh; display: flex; align-items: center; padding: 12rem 4rem; position: relative; background: var(--surface); }
    #about .sec-glow { top: 20%; right: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(122,139,106,0.06) 0%, transparent 70%); }
    .about-inner { max-width: 750px; position: relative; z-index: 1; }
    .about-inner::before { content: ''; position: absolute; left: -2rem; top: 0; width: 2px; height: 0; background: linear-gradient(to bottom, var(--teal), var(--amber-dim)); transition: height 1s 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .about-inner.v::before { height: 100%; }
    .s-label { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.4em; color: var(--teal); margin-bottom: 2.5rem; display: flex; align-items: center; gap: 0.8rem; }
    .s-label::after { content: ''; width: 30px; height: 1px; background: var(--teal-dim); }
    .about-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6rem); line-height: 0.95; letter-spacing: 0.02em; margin-bottom: 2.5rem; }
    .about-title em { font-style: normal; color: var(--teal); }
    .about-text { font-size: 1rem; line-height: 2; color: var(--muted); max-width: 550px; }
    .about-stats { display: flex; gap: 4rem; margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--border); }
    .stat { display: flex; flex-direction: column; }
    .stat-n { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; line-height: 1; }
    .stat-n.c1 { color: var(--teal); }
    .stat-n.c2 { color: var(--amber); }
    .stat-n.c3 { color: var(--rust); }
    .stat-l { font-family: 'JetBrains Mono', monospace; font-size: 0.5rem; letter-spacing: 0.25em; color: var(--muted); margin-top: 0.4rem; text-transform: uppercase; }

    #work { padding: 10rem 4rem; position: relative; background: var(--dark); }
    .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 4rem; position: relative; z-index: 1; }
    .work-item { display: block; text-decoration: none; color: var(--text); background: #faf8f5; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 40px rgba(42,36,32,0.04); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease; }
    .work-item:hover { transform: translateY(-8px); box-shadow: 0 20px 60px rgba(42,36,32,0.08); }
    .work-item.large { grid-column: 1 / -1; }
    .work-thumb { width: 100%; aspect-ratio: 16/9; position: relative; overflow: hidden; background: #ede8e0; }
    .work-item.large .work-thumb { aspect-ratio: 21/9; }
    .wt-bg { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
    .work-item:hover .wt-bg { transform: scale(1.05); }
    .work-info { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.8rem; border-top: 1px solid #e8e2d8; }
    .work-info h3 { font-size: 1.1rem; font-weight: 700; transition: color 0.3s ease; }
    .work-item:hover .work-info h3 { color: var(--teal); }
    .work-tag { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--muted); background: var(--surface); padding: 0.3rem 0.6rem; border-radius: 4px; }

    #contact { min-height: 85vh; display: flex; flex-direction: column; justify-content: center; padding: 12rem 4rem 4rem; position: relative; background: var(--surface); }
    #contact .sec-glow { bottom: 10%; left: 20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(196,149,106,0.05) 0%, transparent 70%); }
    .contact-inner { margin-bottom: 5rem; position: relative; z-index: 1; }
    .contact-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6.5rem); line-height: 0.95; letter-spacing: 0.02em; margin-bottom: 2.5rem; }
    .contact-email { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: clamp(0.7rem, 1.6vw, 0.95rem); color: var(--teal); text-decoration: none; padding-bottom: 0.5rem; border-bottom: 1px solid var(--teal-dim); margin-bottom: 2.5rem; transition: all 0.3s; word-break: break-all; }
    .contact-email:hover { border-color: var(--teal); text-shadow: 0 0 25px var(--teal-glow); }
    .contact-socials { display: flex; gap: 0; }
    .contact-socials a { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; color: var(--muted); text-decoration: none; padding: 0.5rem 0; margin-right: 2.5rem; position: relative; transition: color 0.3s; }
    .contact-socials a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px; background: var(--teal); transition: width 0.3s; }
    .contact-socials a:hover { color: var(--text); }
    .contact-socials a:hover::after { width: 100%; }
    .footer-line { display: flex; justify-content: space-between; align-items: center; padding-top: 2.5rem; margin-top: auto; border-top: 1px solid var(--border); font-family: 'JetBrains Mono', monospace; font-size: 0.5rem; color: var(--muted); letter-spacing: 0.1em; position: relative; z-index: 1; }
    .footer-line a { color: var(--muted); text-decoration: none; transition: color 0.3s; }
    .footer-line a:hover { color: var(--teal); }

    @media (max-width: 768px) {
      nav { padding: 1.2rem 1.5rem; }
      nav.scrolled { padding: 1rem 1.5rem; }
      .nav-links { gap: 1.5rem; }
      .hud-fr, .hud-cl, .hud-snd { display: none; }
      .lb { height: 4vh; }
      #about { padding: 8rem 1.5rem; }
      .wm { display: none; }
      #work { padding: 6rem 1.5rem; }
      #contact { padding: 8rem 1.5rem 2rem; }
      .work-grid { grid-template-columns: 1fr 1fr; }
      .about-stats { flex-direction: column; gap: 1.5rem; }
      .contact-socials { flex-direction: column; }
      .contact-socials a { margin-right: 0; margin-bottom: 0.5rem; }
      .footer-line { flex-direction: column; gap: 0.75rem; text-align: center; }
      .cur-dot, .cur-ring { display: none; }
      body { cursor: auto; }
      .hero-inv { display: none; }
    }
  </style>
  <div class="loader" id="loader">
    <div class="loader-initials"><span>S</span><span>U</span><span>C</span><span>H</span><span>I</span><span>N</span><span>T</span><span>H</span><span>A</span></div>
        <div class="loader-track">
      <div class="loader-fill" id="loaderFill"></div>
    </div>
    <div class="loader-pct" id="loaderPct">000%</div>
  </div>

  <div class="cur-dot" id="cDot"></div>
  <div class="cur-ring" id="cRing"></div>
  <div class="lb lb-t" id="lbT"></div>
  <div class="lb lb-b" id="lbB"></div>

  <nav id="nav">
    <a href="/" class="nav-logo">←</a>
    <div class="nav-links">
      <a href="/" class="nav-link active">Projects</a>
      <a href="/contact" class="nav-link">&lt;/&gt; Contact</a>
    </div>
  </nav>

  <section id="hero">
    <div class="dev-grid-bg"></div>
    <div class="hero-vig"></div>
    <div class="hero-grad"></div>
    <div class="hero-ambient"></div>
    <canvas id="dustCanvas"></canvas>
    <div class="hero-inv">SYS.ROOT</div>
    <div class="hud hud-fr"><div class="hl">LINES</div><div class="nm" id="lineCount">000000</div></div>
    <div class="hud hud-cl"><span class="tm" id="clock">00:00:00</span></div>
    <div class="hud hud-snd" id="sndToggle"><div class="dot"></div><span>LOGS</span></div>
    <div class="hero-content">
      <p class="hero-label">&gt; WEB_PORTFOLIO — INITIALIZED</p>
      <h1 class="hero-title">ARCHITECTING<br/><span class="l2">THE WEB</span></h1>
      <p class="hero-sub">Engineering clean, scalable digital experiences.</p>
      <a href="#work" class="hero-btn">VIEW STACK ↓</a>
    </div>
    <div class="scroll-hint"><span>SCROLL</span><div class="scroll-bar"></div></div>
  </section>
  <div class="sdiv"></div>

  <section id="about">
    <div class="sec-glow"></div>
    <div class="wm wm-wk">002</div>
    <div class="about-inner rv">
      <div class="s-label">◆ 001 — ABOUT</div>
      <h2 class="about-title">A DEVELOPER<br/>& <em>ENGINEER</em></h2>
      <p class="about-text">I build interfaces that live between logic and aesthetics — the quiet structure behind a seamless interaction, the architecture that scales when it matters. Focused on modern frontend stacks, performant systems, and sharp user experiences.</p>
      <div class="about-stats">
        <div class="stat"><div class="stat-n c1">50+</div><div class="stat-l">Projects</div></div>
        <div class="stat"><div class="stat-n c2">4+</div><div class="stat-l">Years</div></div>
        <div class="stat"><div class="stat-n c3">15+</div><div class="stat-l">Technologies</div></div>
      </div>
    </div>
  </section>
  <div class="sdiv"></div>

  <section id="work">
    <div class="wm wm-wk">002</div>
    <div class="s-label rv" style="position:relative;z-index:1;">◆ 002 — WEB PROJECTS</div>
    <div class="work-grid">
      <a href="https://harithengineering.com/" target="_blank" class="work-item large rv">
        <div class="work-thumb"><img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1600&q=80" alt="Harith Engineering" class="wt-bg" /></div>
        <div class="work-info"><h3>Harith Engineering</h3><span class="work-tag">React / Tailwind / Vite</span></div>
      </a>
      <a href="#" class="work-item rv rv-d1">
        <div class="work-thumb"><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="Project 2" class="wt-bg" /></div>
        <div class="work-info"><h3>Fluid Commerce Platform</h3><span class="work-tag">React / Node.js</span></div>
      </a>
      <a href="#" class="work-item rv rv-d2">
        <div class="work-thumb"><img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?auto=format&fit=crop&w=800&q=80" alt="Project 3" class="wt-bg" /></div>
        <div class="work-info"><h3>Syne Portfolio Engine</h3><span class="work-tag">Astro / Three.js</span></div>
      </a>
      <a href="#" class="work-item rv rv-d3">
        <div class="work-thumb"><img src="https://images.unsplash.com/photo-1618477388954-7852f32655ec?auto=format&fit=crop&w=800&q=80" alt="Project 4" class="wt-bg" /></div>
        <div class="work-info"><h3>DataSync REST API</h3><span class="work-tag">Python / FastAPI</span></div>
      </a>
    </div>
  </section>
  <div class="sdiv"></div>

  <section id="contact">
    <div class="sec-glow"></div>
    <div class="wm wm-ct">003</div>
