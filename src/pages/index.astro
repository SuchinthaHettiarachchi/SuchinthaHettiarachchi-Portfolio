---
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Suchintha Hettiarachchi</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet"/>
</head>
<body>

  <!-- LOADING SCREEN -->
  <div id="loader">
    <div class="loader-bg"></div>
    <div class="glitch-wrap">
      <span class="glitch-line code">&lt;/&gt; initializing...</span>
      <span class="glitch-line film">◉ REC — rolling...</span>
      <span class="glitch-line code">npm install identity</span>
      <span class="glitch-line film">frame 001 — locked</span>
    </div>
    <div class="loader-name">
      <span>S</span><span>U</span><span>C</span><span>H</span><span>I</span><span>N</span><span>T</span><span>H</span><span>A</span>
    </div>
    <div class="loader-sub">HETTIARACHCHI</div>
  </div>

  <!-- SPLIT LANDING -->
  <main id="landing">

    <!-- STACK SIDE -->
    <div class="side" id="stack-side">
      <div class="side-bg stack-bg"></div>
      <div class="side-content">
        <p class="side-label code-font">&lt;dev&gt;</p>
        <h2 class="side-title">STACK</h2>
        <p class="side-desc">Engineering ideas into reality.<br/>Clean code. Sharp interfaces.</p>
        <a href="/stack" class="side-btn stack-btn">Enter Stack →</a>
      </div>
      <div class="stack-lines"></div>
    </div>

    <!-- DIVIDER -->
    <div class="divider">
      <span>SH</span>
    </div>

    <!-- FRAME SIDE -->
    <div class="side" id="frame-side">
      <div class="side-bg frame-bg"></div>
      <div class="grain-overlay"></div>
      <div class="side-content">
        <p class="side-label">◉ cinematic</p>
        <h2 class="side-title">FRAME</h2>
        <p class="side-desc">Capturing worlds between<br/>light and shadow.</p>
        <a href="/frame" class="side-btn frame-btn">Enter Frame →</a>
      </div>
    </div>

  </main>

</body>
</html>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    overflow: hidden;
    font-family: 'Syne', sans-serif;
    background: #000;
  }

  /* ── LOADER ── */
  #loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .glitch-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeIn 0.5s 0.3s forwards;
  }

  .glitch-line {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    opacity: 0;
    transform: translateX(-10px);
  }

  .glitch-line.code {
    color: #4af;
    font-family: 'JetBrains Mono', monospace;
    animation: lineIn 0.4s forwards;
  }

  .glitch-line.film {
    color: #4dcfcf;
    font-family: 'Syne', sans-serif;
    animation: lineIn 0.4s forwards;
  }

  .glitch-line:nth-child(1) { animation-delay: 0.3s; }
  .glitch-line:nth-child(2) { animation-delay: 0.7s; }
  .glitch-line:nth-child(3) { animation-delay: 1.1s; }
  .glitch-line:nth-child(4) { animation-delay: 1.5s; }

  @keyframes lineIn {
    to { opacity: 1; transform: translateX(0); }
  }

  .loader-name {
    display: flex;
    gap: 0.1em;
    overflow: hidden;
  }

  .loader-name span {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    color: #fff;
    opacity: 0;
    transform: translateY(40px);
    display: inline-block;
    animation: letterUp 0.5s forwards;
  }

  .loader-name span:nth-child(1) { animation-delay: 1.9s; }
  .loader-name span:nth-child(2) { animation-delay: 2.0s; }
  .loader-name span:nth-child(3) { animation-delay: 2.1s; }
  .loader-name span:nth-child(4) { animation-delay: 2.2s; }
  .loader-name span:nth-child(5) { animation-delay: 2.3s; }
  .loader-name span:nth-child(6) { animation-delay: 2.4s; }
  .loader-name span:nth-child(7) { animation-delay: 2.5s; }
  .loader-name span:nth-child(8) { animation-delay: 2.6s; }
  .loader-name span:nth-child(9) { animation-delay: 2.7s; }

  @keyframes letterUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .loader-sub {
    font-size: clamp(0.7rem, 2vw, 1rem);
    letter-spacing: 0.5em;
    color: #666;
    opacity: 0;
    animation: fadeIn 0.8s 3s forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  /* ── LANDING ── */
  #landing {
    display: flex;
    height: 100vh;
    width: 100vw;
    opacity: 0;
    animation: fadeIn 1s 3.8s forwards;
  }

  .side {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: flex 0.7s cubic-bezier(0.77, 0, 0.18, 1);
    cursor: pointer;
  }

  #landing:has(#stack-side:hover) #stack-side { flex: 1.8; }
  #landing:has(#stack-side:hover) #frame-side { flex: 0.5; }
  #landing:has(#frame-side:hover) #frame-side { flex: 1.8; }
  #landing:has(#frame-side:hover) #stack-side { flex: 0.5; }

  /* STACK BG */
  .stack-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #fff 100%);
    opacity: 0.95;
  }

  /* stack grid lines */
  .stack-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(74,170,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74,170,255,0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  /* FRAME BG */
  .frame-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0a1628 0%, #0d2b3e 40%, #0a3d3d 70%, #061a1a 100%);
  }

  /* film grain */
  .grain-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    pointer-events: none;
    animation: grainMove 0.5s steps(2) infinite;
  }

  @keyframes grainMove {
    0% { transform: translate(0,0); }
    25% { transform: translate(-2px, 1px); }
    50% { transform: translate(1px, -2px); }
    75% { transform: translate(2px, 1px); }
    100% { transform: translate(-1px, 2px); }
  }

  /* SIDE CONTENT */
  .side-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    transition: opacity 0.4s;
  }

  .side-label {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.6;
  }

  #stack-side .side-label { color: #4af; font-family: 'JetBrains Mono', monospace; }
  #frame-side .side-label { color: #4dcfcf; }

  .side-title {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    line-height: 1;
  }

  #stack-side .side-title { color: #fff; }
  #frame-side .side-title { color: #e0f5f5; text-shadow: 0 0 40px rgba(77,207,207,0.3); }

  .side-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s 0.1s, transform 0.4s 0.1s;
  }

  #stack-side .side-desc { color: #aaa; }
  #frame-side .side-desc { color: #8ecece; }

  .side:hover .side-desc {
    opacity: 1;
    transform: translateY(0);
  }

  .side-btn {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s 0.2s, transform 0.4s 0.2s;
  }

  .side:hover .side-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .stack-btn {
    background: #fff;
    color: #000;
    border: none;
  }

  .stack-btn:hover { background: #4af; }

  .frame-btn {
    background: transparent;
    color: #4dcfcf;
    border: 1px solid #4dcfcf;
  }

  .frame-btn:hover { background: rgba(77,207,207,0.1); }

  /* DIVIDER */
  .divider {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #000;
    border: 1px solid #333;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 800;
    color: #666;
    letter-spacing: 0.05em;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 1s 4.2s forwards;
  }

  .code-font { font-family: 'JetBrains Mono', monospace; }
</style>

<script>
  // Hide loader and show landing after animation completes
  setTimeout(() => {
    const loader = document.getElementById('loader');
    loader.style.transition = 'opacity 0.8s';
    loader.style.opacity = '0';
    setTimeout(() => loader.style.display = 'none', 800);
    document.body.style.overflow = 'auto';
  }, 3600);
</script>