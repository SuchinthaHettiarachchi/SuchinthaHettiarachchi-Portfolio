<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Suchintha Hettiarachchi</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet"/>
</head>
<body>

  <!-- LOADER -->
  <div id="loader">
    <div class="loader-left">
      <div class="loader-fill" id="loader-fill"></div>
    </div>
    <div class="loader-name">
      <p class="loader-name-top">HETTIARACHCHI</p>
      <h1 class="loader-name-main">SUCHINTHA</h1>
      <p class="loader-name-role">DEVELOPER & FILMMAKER</p>
    </div>
    <div class="loader-bottom">
      <div class="loader-percent"><span id="percent">0</span>%</div>
      <div class="loader-bar-wrap">
        <div class="loader-bar" id="loader-bar"></div>
      </div>
    </div>
  </div>

  <!-- MAIN -->
  <main id="main" style="opacity:0;">

    <!-- HERO SPLIT -->
    <section id="hero">

      <!-- STACK SIDE -->
      <div class="side" id="stack-side" onclick="window.location='/stack'">
        <div class="side-bg stack-bg"></div>
        <div class="grid-overlay"></div>
        <div class="side-content">
          <div class="side-letters">
            <span>S</span><span>T</span><span>A</span><span>C</span><span>K</span>
          </div>
          <div class="side-meta">
            <p class="side-label code-font">&lt;dev /&gt;</p>
            <p class="side-desc">Engineering ideas<br/>into reality.</p>
            <span class="side-enter">Enter →</span>
          </div>
        </div>
      </div>

      <!-- CENTER -->
      <div class="center-line">
        <div class="center-badge">SH</div>
      </div>

      <!-- FRAME SIDE -->
      <div class="side" id="frame-side" onclick="window.location='/frame'">
        <div class="side-bg frame-bg"></div>
        <div class="grain-overlay"></div>
        <div class="side-content">
          <div class="side-letters frame-letters">
            <span>F</span><span>R</span><span>A</span><span>M</span><span>E</span>
          </div>
          <div class="side-meta">
            <p class="side-label">◉ cinematic</p>
            <p class="side-desc">Capturing worlds<br/>between light and shadow.</p>
            <span class="side-enter frame-enter">Enter →</span>
          </div>
        </div>
      </div>

    </section>

    <!-- MARQUEE -->
    <div class="marquee-wrap">
      <div class="marquee-track">
        <span>DEVELOPER</span>
        <span class="dot">·</span>
        <span>FILMMAKER</span>
        <span class="dot">·</span>
        <span>CREATIVE</span>
        <span class="dot">·</span>
        <span>SRI LANKA</span>
        <span class="dot">·</span>
        <span>STACK</span>
        <span class="dot">·</span>
        <span>FRAME</span>
        <span class="dot">·</span>
        <span>DEVELOPER</span>
        <span class="dot">·</span>
        <span>FILMMAKER</span>
        <span class="dot">·</span>
        <span>CREATIVE</span>
        <span class="dot">·</span>
        <span>SRI LANKA</span>
        <span class="dot">·</span>
        <span>STACK</span>
        <span class="dot">·</span>
        <span>FRAME</span>
        <span class="dot">·</span>
      </div>
    </div>

    <!-- INTRO SECTION -->
    <section id="intro">
      <div class="intro-inner">
        <p class="intro-tag">[ 001 — ABOUT ]</p>
        <h2 class="intro-heading">
          <span class="reveal-text">I'M SUCHINTHA —</span><br/>
          <span class="reveal-text outline-text">A DEVELOPER</span><br/>
          <span class="reveal-text">& FILMMAKER</span>
        </h2>
        <p class="intro-body">
          Based in Sri Lanka. I build sharp, functional web experiences and capture cinematic stories between light and shadow. Two worlds. One vision.
        </p>
        <div class="intro-links">
          <a href="/stack" class="intro-link stack-link">&lt;/&gt; Enter Stack</a>
          <a href="/frame" class="intro-link frame-link">◉ Enter Frame</a>
        </div>
      </div>
      <div class="intro-side">
        <div class="intro-stat">
          <span class="stat-n">10+</span>
          <span class="stat-l">Projects Built</span>
        </div>
        <div class="intro-stat">
          <span class="stat-n">2+</span>
          <span class="stat-l">Years Experience</span>
        </div>
        <div class="intro-stat">
          <span class="stat-n">2</span>
          <span class="stat-l">Worlds. One Portfolio.</span>
        </div>
      </div>
    </section>

    <!-- MARQUEE 2 (reverse) -->
    <div class="marquee-wrap marquee-dark">
      <div class="marquee-track marquee-reverse">
        <span>CLEAN CODE</span>
        <span class="dot">·</span>
        <span>CINEMATIC VISION</span>
        <span class="dot">·</span>
        <span>SHARP INTERFACES</span>
        <span class="dot">·</span>
        <span>BOLD FRAMES</span>
        <span class="dot">·</span>
        <span>CLEAN CODE</span>
        <span class="dot">·</span>
        <span>CINEMATIC VISION</span>
        <span class="dot">·</span>
        <span>SHARP INTERFACES</span>
        <span class="dot">·</span>
        <span>BOLD FRAMES</span>
        <span class="dot">·</span>
      </div>
    </div>

    <!-- WORLDS SECTION -->
    <section id="worlds">
      <p class="section-tag">[ 002 — WORLDS ]</p>
      <div class="worlds-grid">

        <a href="/stack" class="world-card stack-card">
          <div class="world-card-bg"></div>
          <div class="world-card-content">
            <p class="world-num code-font">01</p>
            <h3>STACK</h3>
            <p class="world-desc">Web development. Clean code. Sharp interfaces. Scalable systems built to last.</p>
            <div class="world-tags">
              <span>React</span><span>Astro</span><span>Node.js</span>
            </div>
            <span class="world-cta">Explore Stack →</span>
          </div>
        </a>

        <a href="/frame" class="world-card frame-card">
          <div class="world-card-bg frame-card-bg"></div>
          <div class="world-card-content">
            <p class="world-num">02</p>
            <h3>FRAME</h3>
            <p class="world-desc">Cinematic storytelling. Visual art. Capturing worlds between light and shadow.</p>
            <div class="world-tags">
              <span>Film</span><span>Video</span><span>Visual Art</span>
            </div>
            <span class="world-cta frame-cta">Explore Frame →</span>
          </div>
        </a>

      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="footer-left">
        <p class="footer-name">SUCHINTHA HETTIARACHCHI</p>
        <p class="footer-role">Developer & Filmmaker · Sri Lanka</p>
      </div>
      <div class="footer-right">
        <a href="/stack">Stack</a>
        <a href="/frame">Frame</a>
        <a href="mailto:you@email.com">Email</a>
      </div>
      <p class="footer-copy">© 2026 Suchintha Hettiarachchi. All rights reserved.</p>
    </footer>

  </main>

</body>
</html>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --blue: #4aaeff;
    --teal: #4dcfcf;
    --dark: #080808;
    --white: #f0f0f0;
    --muted: #444;
    --border: #1a1a1a;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--dark);
    color: var(--white);
    font-family: 'Syne', sans-serif;
    overflow-x: hidden;
  }

  .code-font { font-family: 'JetBrains Mono', monospace; }

  /* ── LOADER ── */
  #loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #000;
    overflow: hidden;
  }

  /* LEFT water fill */
  .loader-left {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    bottom: 0;
    background: #111;
    overflow: hidden;
  }

  .loader-fill {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 0%;
    background: #fff;
    transition: height 0.06s linear;
  }

  /* NAME — perfectly centered */
  .loader-name {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    z-index: 2;
    pointer-events: none;
  }

  .loader-name-top {
    font-size: clamp(0.6rem, 1.5vw, 0.85rem);
    letter-spacing: 0.6em;
    color: #333;
    margin-bottom: 0.8rem;
  }

  .loader-name-main {
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-weight: 800;
    line-height: 1;
    color: #fff;
    letter-spacing: 0.05em;
  }

  .loader-name-role {
    font-size: clamp(0.55rem, 1.2vw, 0.75rem);
    letter-spacing: 0.4em;
    color: #2a2a2a;
    margin-top: 1rem;
  }

  /* BOTTOM CENTER — percent + bar */
  .loader-bottom {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    z-index: 3;
    width: 200px;
  }

  .loader-percent {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    color: #fff;
    line-height: 1;
  }

  .loader-bar-wrap {
    width: 100%;
    height: 1px;
    background: #1a1a1a;
  }

  .loader-bar {
    height: 1px;
    background: #fff;
    width: 0%;
    transition: width 0.06s linear;
  }

  /* ── HERO SPLIT ── */
  #hero {
    position: relative;
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .side {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    transition: flex 0.8s cubic-bezier(0.77, 0, 0.18, 1);
  }

  #hero:has(#stack-side:hover) #stack-side { flex: 1.7; }
  #hero:has(#stack-side:hover) #frame-side { flex: 0.5; }
  #hero:has(#frame-side:hover) #frame-side { flex: 1.7; }
  #hero:has(#frame-side:hover) #stack-side { flex: 0.5; }

  .stack-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #080808 0%, #0f0f1a 60%, #1a1a2e 100%);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(74,174,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74,174,255,0.04) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .frame-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #060e14 0%, #0a2a3a 50%, #0a3d3d 100%);
  }

  .grain-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px;
    animation: grain 0.5s steps(2) infinite;
    pointer-events: none;
  }

  @keyframes grain {
    0%,100% { transform: translate(0,0); }
    25% { transform: translate(-2px,1px); }
    50% { transform: translate(1px,-2px); }
    75% { transform: translate(2px,1px); }
  }

  .side-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
  }

  .side-letters {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.9;
  }

  .side-letters span {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    color: #fff;
    transition: color 0.3s;
  }

  .frame-letters span { color: #e0f5f5; }

  .side-meta {
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s, transform 0.4s;
  }

  .side:hover .side-meta { opacity: 1; transform: translateY(0); }

  .side-label {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }

  #frame-side .side-label { color: var(--teal); }

  .side-desc {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .side-enter {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.1em;
  }

  .frame-enter { color: var(--teal); }

  .center-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    pointer-events: none;
  }

  .center-badge {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #000;
    border: 1px solid #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 800;
    color: #555;
    letter-spacing: 0.05em;
  }

  /* ── MARQUEE ── */
  .marquee-wrap {
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.2rem 0;
    background: var(--dark);
  }

  .marquee-dark { background: #050505; }

  .marquee-track {
    display: flex;
    gap: 2rem;
    width: max-content;
    animation: marquee 20s linear infinite;
  }

  .marquee-reverse { animation: marqueeReverse 20s linear infinite; }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes marqueeReverse {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  .marquee-track span {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: #333;
    white-space: nowrap;
  }

  .marquee-track .dot { color: var(--blue); }
  .marquee-reverse .dot { color: var(--teal); }

  /* ── INTRO ── */
  #intro {
    display: flex;
    align-items: center;
    gap: 6rem;
    padding: 10rem 6rem;
    border-bottom: 1px solid var(--border);
  }

  .intro-inner { flex: 1; }

  .intro-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--blue);
    letter-spacing: 0.3em;
    margin-bottom: 2rem;
  }

  .intro-heading {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 2rem;
  }

  .outline-text {
    -webkit-text-stroke: 2px var(--white);
    color: transparent;
  }

  .reveal-text {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s, transform 0.7s;
  }

  .reveal-text.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .intro-body {
    font-size: 1rem;
    color: #555;
    line-height: 1.9;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }

  .intro-links { display: flex; gap: 1rem; }

  .intro-link {
    padding: 0.7rem 1.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s;
  }

  .stack-link {
    background: var(--white);
    color: var(--dark);
    font-family: 'JetBrains Mono', monospace;
  }

  .stack-link:hover { background: var(--blue); }

  .frame-link {
    border: 1px solid var(--teal);
    color: var(--teal);
    background: transparent;
  }

  .frame-link:hover { background: rgba(77,207,207,0.1); }

  .intro-side {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    flex-shrink: 0;
  }

  .intro-stat { display: flex; flex-direction: column; gap: 0.3rem; }

  .stat-n {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
  }

  .stat-l {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: #444;
  }

  /* ── WORLDS ── */
  #worlds {
    padding: 8rem 6rem;
    border-bottom: 1px solid var(--border);
  }

  .section-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #444;
    letter-spacing: 0.3em;
    margin-bottom: 3rem;
  }

  .worlds-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .world-card {
    position: relative;
    padding: 3rem;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--white);
    overflow: hidden;
    display: block;
    transition: border-color 0.4s;
  }

  .world-card:hover { border-color: #333; }

  .world-card-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0d0d0d 0%, #111 100%);
    transition: opacity 0.4s;
  }

  .frame-card-bg {
    background: linear-gradient(135deg, #060e14 0%, #0a2020 100%);
  }

  .world-card:hover .world-card-bg { opacity: 0.7; }

  .world-card-content {
    position: relative;
    z-index: 2;
  }

  .world-num {
    font-size: 0.7rem;
    color: #333;
    letter-spacing: 0.3em;
    margin-bottom: 1.5rem;
  }

  .stack-card .world-num { color: var(--blue); font-family: 'JetBrains Mono', monospace; }
  .frame-card .world-num { color: var(--teal); }

  .world-card h3 {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .world-desc {
    font-size: 0.9rem;
    color: #555;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 360px;
  }

  .world-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .world-tags span {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    padding: 0.2rem 0.6rem;
    border: 1px solid #1a1a1a;
    color: #444;
    font-family: 'JetBrains Mono', monospace;
  }

  .world-cta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--blue);
    letter-spacing: 0.1em;
  }

  .frame-cta { color: var(--teal); }

  /* ── FOOTER ── */
  footer {
    padding: 4rem 6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 2rem;
    border-top: 1px solid var(--border);
  }

  .footer-name {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .footer-role {
    font-size: 0.7rem;
    color: #444;
    letter-spacing: 0.1em;
    margin-top: 0.3rem;
  }

  .footer-right {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .footer-right a {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #444;
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-right a:hover { color: var(--white); }

  .footer-copy {
    grid-column: 1 / -1;
    font-size: 0.7rem;
    color: #2a2a2a;
    letter-spacing: 0.1em;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
</style>

<script>
  const percentEl = document.getElementById('percent');
  const barEl = document.getElementById('loader-bar');
  const fillEl = document.getElementById('loader-fill');
  const loader = document.getElementById('loader');
  const main = document.getElementById('main');

  let current = 0;

  const countInterval = setInterval(() => {
    current += Math.floor(Math.random() * 3) + 1;
    if (current >= 100) {
      current = 100;
      clearInterval(countInterval);
      setTimeout(() => {
        loader.style.transition = 'opacity 0.8s';
        loader.style.opacity = '0';
        main.style.transition = 'opacity 0.8s';
        main.style.opacity = '1';
        setTimeout(() => {
          loader.style.display = 'none';
          document.body.style.overflow = 'auto';
        }, 800);
      }, 400);
    }
    percentEl.textContent = current;
    barEl.style.width = current + '%';
    fillEl.style.height = current + '%';
  }, 40);

  // ── SCROLL REVEAL ──
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.2 });

  document.querySelectorAll('.reveal-text').forEach((el, i) => {
    el.style.transitionDelay = `${i * 0.15}s`;
    observer.observe(el);
  });
</script>