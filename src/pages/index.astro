---
import MinimalLayout from '../layouts/MinimalLayout.astro';
---

<MinimalLayout title="Suchintha Hettiarachchi">
  
  <!-- 3D ORBITING LANGUAGES LOADER -->
  <div class="loader" id="loader">
    <div class="loader-scene">
      <div class="loader-center">SH</div>
      
      <div class="orbit orbit-inner">
        <div class="orbit-icon" style="--i:0">JS</div>
        <div class="orbit-icon" style="--i:1">TS</div>
        <div class="orbit-icon" style="--i:2">PY</div>
        <div class="orbit-icon" style="--i:3">C++</div>
      </div>

      <div class="orbit orbit-outer">
        <div class="orbit-icon outer" style="--i:0">REACT</div>
        <div class="orbit-icon outer" style="--i:1">NODE</div>
        <div class="orbit-icon outer" style="--i:2">CSS</div>
        <div class="orbit-icon outer" style="--i:3">HTML</div>
      </div>
    </div>
  </div>

  <main class="home-container" id="mainContent">
    
    <div class="home-ambient"></div>

    <div class="home-content">
      <p class="home-tag code-font load-anim" style="--d: 0.2s">// PORTFOLIO</p>
      
      <h1 class="mega-name">
        <span class="name-first load-anim" style="--d: 0.4s">SUCHINTHA</span><br/>
        <span class="name-last load-anim" style="--d: 0.6s">HETTIARACHCHI</span>
      </h1>
      
      <!-- Changed to Developer & Engineer -->
      <p class="home-role load-anim" style="--d: 0.8s">DEVELOPER & ENGINEER</p>
    </div>

    <div class="home-links">
      <a href="/stack" class="home-link stack-link load-anim" style="--d: 1.0s">
        <span class="link-number code-font">01</span>
        <span class="link-text">Enter Stack</span>
        <span class="link-arrow">→</span>
      </a>

      <!-- Removed Frame, updated numbers -->
      <a href="/contact" class="home-link contact-link load-anim" style="--d: 1.2s">
        <span class="link-number code-font">02</span>
        <span class="link-text">Contact</span>
        <span class="link-arrow">→</span>
      </a>
    </div>

  </main>
</MinimalLayout>

<style>
  /* ── 1. ORBITING LOADER ── */
  .loader {
    position: fixed; inset: 0; z-index: 9999; background: #000;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }
  .loader.out { opacity: 0; visibility: hidden; }

  .loader-scene {
    position: relative; width: 300px; height: 300px;
    display: flex; align-items: center; justify-content: center;
    transform-style: preserve-3d; perspective: 800px;
  }

  .loader-center {
    font-family: 'Syne', sans-serif; font-size: 4rem; font-weight: 800;
    color: #fff; z-index: 2; letter-spacing: -0.02em;
  }

  .orbit { position: absolute; width: 100%; height: 100%; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .orbit-inner { animation: spin 8s linear infinite; }
  .orbit-outer { width: 140%; height: 140%; animation: spin-reverse 12s linear infinite; }

  @keyframes spin { from { transform: rotate(0deg) rotateX(65deg); } to { transform: rotate(360deg) rotateX(65deg); } }
  @keyframes spin-reverse { from { transform: rotate(0deg) rotateX(65deg); } to { transform: rotate(-360deg) rotateX(65deg); } }

  .orbit-icon {
    position: absolute; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; color: #c9a84c; background: rgba(201, 168, 76, 0.1);
    border: 1px solid rgba(201, 168, 76, 0.3); padding: 0.4rem 0.8rem; border-radius: 20px;
    transform: rotate(calc(var(--i) * 90deg)) translateX(110px) rotateX(-65deg);
    animation: counter-spin 8s linear infinite; backdrop-filter: blur(4px);
  }

  .orbit-icon.outer {
    color: #2d8a8a; background: rgba(45, 138, 138, 0.1); border-color: rgba(45, 138, 138, 0.3);
    transform: rotate(calc(var(--i) * 90deg)) translateX(150px) rotateX(-65deg);
    animation: counter-spin-reverse 12s linear infinite;
  }

  @keyframes counter-spin { from { transform: rotate(calc(var(--i) * 90deg)) translateX(110px) rotateX(-65deg) rotate(0deg); } to { transform: rotate(calc(var(--i) * 90deg)) translateX(110px) rotateX(-65deg) rotate(-360deg); } }
  @keyframes counter-spin-reverse { from { transform: rotate(calc(var(--i) * 90deg)) translateX(150px) rotateX(-65deg) rotate(0deg); } to { transform: rotate(calc(var(--i) * 90deg)) translateX(150px) rotateX(-65deg) rotate(360deg); } }


  /* ── 2. MAIN HOMEPAGE ── */
  .home-container {
    min-height: 100vh; display: flex; flex-direction: column; justify-content: flex-start;
    padding: 15vh 6vw 5vh 6vw; position: relative; overflow: hidden;
    opacity: 0; transition: opacity 0.8s 0.2s ease;
  }
  .home-container.revealed { opacity: 1; }

  .home-ambient {
    position: absolute; top: 20%; left: 40%; width: 40vw; height: 40vw;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.04) 0%, transparent 70%);
    transform: translate(-50%, -50%); pointer-events: none; z-index: 0;
  }

  .home-content { position: relative; z-index: 1; }
  .home-tag { font-size: 0.8rem; color: #444444; letter-spacing: 0.2em; margin-bottom: 2rem; }

  .mega-name {
    font-size: clamp(4rem, 12vw, 12rem); font-weight: 800; line-height: 0.85;
    letter-spacing: -0.03em; margin-bottom: 2rem;
  }
  .name-first { color: #ffffff; display: block; }
  .name-last { -webkit-text-stroke: 2px #c9a84c; color: transparent; display: block; text-shadow: 0 0 60px rgba(201, 168, 76, 0.1); }

  .home-role { font-size: 1rem; color: #555555; letter-spacing: 0.4em; text-transform: uppercase; }

  .load-anim {
    opacity: 0; transform: translateY(40px);
    animation: smoothReveal 1s cubic-bezier(0.16, 1, 0.3, 1) var(--d) forwards;
  }
  @keyframes smoothReveal { to { opacity: 1; transform: translateY(0); } }


  /* ── 3. MENU LINKS ── */
  .home-links { margin-top: 8rem; display: flex; flex-direction: column; gap: 1.5rem; max-width: 400px; position: relative; z-index: 1; }

  .home-link {
    display: flex; align-items: center; gap: 1.5rem; text-decoration: none; color: #ffffff;
    padding-bottom: 1.5rem; border-bottom: 1px solid #1a1a1a; transition: all 0.3s ease;
  }

  .link-number { font-size: 0.7rem; color: #333333; transition: color 0.3s ease; }
  .link-text { font-size: 1.5rem; font-weight: 700; flex: 1; transition: all 0.3s ease; }
  .link-arrow { font-size: 1.5rem; color: #333333; transition: all 0.3s ease; }

  .home-link.stack-link:hover { padding-left: 1rem; border-bottom-color: #2d8a8a; }
  .home-link.stack-link:hover .link-arrow { transform: translateX(5px); color: #2d8a8a; }
  .home-link.stack-link:hover .link-text { color: #2d8a8a; }
  .home-link.stack-link:hover .link-number { color: #2d8a8a; }

  .home-link.contact-link:hover { padding-left: 1rem; border-bottom-color: #00ff66; }
  .home-link.contact-link:hover .link-arrow { transform: translateX(5px); color: #00ff66; }
  .home-link.contact-link:hover .link-text { color: #00ff66; }
  .home-link.contact-link:hover .link-number { color: #00ff66; }
</style>

<script>
  const loader = document.getElementById('loader');
  const mainContent = document.getElementById('mainContent');
  setTimeout(() => {
    loader.classList.add('out');
    setTimeout(() => { mainContent.classList.add('revealed'); }, 200);
    setTimeout(() => { loader.style.display = 'none'; }, 1000);
  }, 2500);
</script>
