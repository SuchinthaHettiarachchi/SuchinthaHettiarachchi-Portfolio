---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Frame — Suchintha Hettiarachchi</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet"/>
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">SH</a>
    <div class="nav-links">
      <a href="/frame" class="nav-link active">◉ Frame</a>
      <a href="/stack" class="nav-link">⟨/⟩ Stack</a>
    </div>
  </nav>

  <!-- VIDEO HERO -->
  <section id="hero">
    <video autoplay muted loop playsinline id="bg-video">
      <!-- Replace src with your own video file in /public folder -->
      <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4" />
    </video>
    <div class="video-overlay"></div>
    <div class="grain"></div>
    <div class="hero-content">
      <p class="hero-label">◉ REC — CINEMATIC PORTFOLIO</p>
      <h1 class="hero-title">SEEING<br/>THE UNSEEN</h1>
      <p class="hero-sub">Visual storytelling between light and shadow.</p>
      <a href="#work" class="hero-btn">View Work ↓</a>
    </div>
    <div class="scroll-hint">SCROLL</div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="about-inner">
      <div class="about-label">◉ 001 — ABOUT</div>
      <h2 class="about-title">A FILMMAKER<br/>& VISUAL ARTIST</h2>
      <p class="about-text">I capture stories that live between frames — the quiet tension before a cut, the mood that lingers after the light fades. Based in Sri Lanka, working across cinematic short films, commercial videography, and visual storytelling.</p>
    </div>
  </section>

  <!-- WORK GRID -->
  <section id="work">
    <div class="section-header">
      <span class="section-label">◉ 002 — SELECTED WORK</span>
    </div>
    <div class="work-grid">
      <div class="work-item large">
        <div class="work-thumb" style="background: linear-gradient(135deg, #0a2a3a, #0d4f4f);">
          <span class="work-play">▶</span>
        </div>
        <div class="work-info">
          <h3>Project Title One</h3>
          <span class="work-tag">Short Film · 2024</span>
        </div>
      </div>
      <div class="work-item">
        <div class="work-thumb" style="background: linear-gradient(135deg, #1a0a2e, #0d3a4f);">
          <span class="work-play">▶</span>
        </div>
        <div class="work-info">
          <h3>Project Title Two</h3>
          <span class="work-tag">Commercial · 2024</span>
        </div>
      </div>
      <div class="work-item">
        <div class="work-thumb" style="background: linear-gradient(135deg, #0a1a2e, #0a3d3d);">
          <span class="work-play">▶</span>
        </div>
        <div class="work-info">
          <h3>Project Title Three</h3>
          <span class="work-tag">Documentary · 2023</span>
        </div>
      </div>
      <div class="work-item">
        <div class="work-thumb" style="background: linear-gradient(135deg, #0d2b2b, #1a3a2a);">
          <span class="work-play">▶</span>
        </div>
        <div class="work-info">
          <h3>Project Title Four</h3>
          <span class="work-tag">Music Video · 2023</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <div class="contact-inner">
      <p class="contact-label">◉ 003 — CONTACT</p>
      <h2 class="contact-title">LET'S CREATE<br/>SOMETHING</h2>
      <a href="mailto:you@email.com" class="contact-email">you@email.com</a>
      <div class="contact-socials">
        <a href="#">Instagram</a>
        <a href="#">Vimeo</a>
        <a href="#">YouTube</a>
      </div>
    </div>
    <div class="footer-line">
      <span>© 2026 Suchintha Hettiarachchi</span>
      <a href="/">← Back to Home</a>
    </div>
  </section>

</body>
</html>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --teal: #4dcfcf;
    --teal-dim: #2a8a8a;
    --dark: #060e14;
    --text: #e0f5f5;
    --muted: #5a8a8a;
  }

  body {
    background: var(--dark);
    color: var(--text);
    font-family: 'Syne', sans-serif;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 4rem;
    background: linear-gradient(to bottom, rgba(6,14,20,0.9), transparent);
  }

  .nav-logo {
    font-weight: 800;
    font-size: 1rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.1em;
  }

  .nav-links { display: flex; gap: 2rem; }

  .nav-link {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.3s;
  }

  .nav-link.active { color: var(--teal); }
  .nav-link:hover { color: var(--text); }

  /* HERO */
  #hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6,14,20,0.3) 0%,
      rgba(6,14,20,0.1) 40%,
      rgba(6,14,20,0.8) 100%
    );
  }

  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px;
    animation: grain 0.4s steps(2) infinite;
    pointer-events: none;
  }

  @keyframes grain {
    0%,100% { transform: translate(0,0); }
    25% { transform: translate(-2px,1px); }
    50% { transform: translate(1px,-2px); }
    75% { transform: translate(2px,1px); }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
    opacity: 0;
    transform: translateY(30px);
    animation: heroIn 1s 0.3s forwards;
  }

  @keyframes heroIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.4em;
    color: var(--teal);
    margin-bottom: 2rem;
  }

  .hero-title {
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 800;
    line-height: 0.9;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 80px rgba(77,207,207,0.2);
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
  }

  .hero-btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    border: 1px solid var(--teal);
    color: var(--teal);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    transition: background 0.3s, color 0.3s;
  }

  .hero-btn:hover {
    background: var(--teal);
    color: var(--dark);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    color: var(--muted);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  /* ABOUT */
  #about {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 8rem 4rem;
    border-top: 1px solid #0d2b2b;
  }

  .about-inner { max-width: 800px; }

  .about-label {
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: var(--teal);
    margin-bottom: 2rem;
  }

  .about-title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 2rem;
  }

  .about-text {
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--muted);
    max-width: 600px;
  }

  /* WORK */
  #work {
    padding: 6rem 4rem;
    border-top: 1px solid #0d2b2b;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-label {
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: var(--teal);
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }

  .work-item.large {
    grid-column: 1 / -1;
  }

  .work-thumb {
    width: 100%;
    aspect-ratio: 16/7;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s;
  }

  .work-item:not(.large) .work-thumb {
    aspect-ratio: 16/9;
  }

  .work-thumb:hover { transform: scale(1.01); }

  .work-play {
    font-size: 2rem;
    color: rgba(255,255,255,0.3);
    transition: color 0.3s, transform 0.3s;
  }

  .work-thumb:hover .work-play {
    color: var(--teal);
    transform: scale(1.2);
  }

  .work-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid #0d2b2b;
  }

  .work-info h3 {
    font-size: 1rem;
    font-weight: 700;
  }

  .work-tag {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  /* CONTACT */
  #contact {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 4rem 4rem;
    border-top: 1px solid #0d2b2b;
  }

  .contact-inner { margin-bottom: 4rem; }

  .contact-label {
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    color: var(--teal);
    margin-bottom: 2rem;
  }

  .contact-title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 2rem;
  }

  .contact-email {
    display: block;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    color: var(--teal);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: opacity 0.3s;
  }

  .contact-email:hover { opacity: 0.7; }

  .contact-socials {
    display: flex;
    gap: 2rem;
  }

  .contact-socials a {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-socials a:hover { color: var(--text); }

  .footer-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid #0d2b2b;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .footer-line a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-line a:hover { color: var(--text); }
</style>

<script>
  // Fade in sections on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('#about, #work, #contact').forEach(section => {
    section.style.opacity = '0';
    section.style.transform = 'translateY(40px)';
    section.style.transition = 'opacity 0.8s, transform 0.8s';
    observer.observe(section);
  });
</script>