  <script>
    /* ── PROLOGUE ── */
    document.body.style.overflow = 'hidden';
    const prologue = document.getElementById('prologue');

    function endPrologue() {
      prologue.classList.add('out');
      document.body.style.overflow = '';
      setTimeout(() => { prologue.style.display = 'none'; }, 800);
    }

    setTimeout(endPrologue, 2500);

    /* ── CURSOR ── */
    const cDot = document.getElementById('cDot');
    const cRing = document.getElementById('cRing');
    let mx = 0, my = 0, rx = 0, ry = 0;

    document.addEventListener('mousemove', e => {
      mx = e.clientX;
      my = e.clientY;
      cDot.style.left = mx - 2.5 + 'px';
      cDot.style.top = my - 2.5 + 'px';
    });

    (function ringLoop() {
      rx += (mx - rx) * 0.1;
      ry += (my - ry) * 0.1;
      cRing.style.left = rx - 16 + 'px';
      cRing.style.top = ry - 16 + 'px';
      requestAnimationFrame(ringLoop);
    })();

    document.querySelectorAll('a, .skill-card, .project-item').forEach(el => {
      el.addEventListener('mouseenter', () => cRing.classList.add('h'));
      el.addEventListener('mouseleave', () => cRing.classList.remove('h'));
    });

    /* ── LETTERBOX + NAV ── */
    const lbT = document.getElementById('lbT');
    const lbB = document.getElementById('lbB');
    const heroEl = document.getElementById('hero');

    window.addEventListener('scroll', () => {
      const s = window.scrollY;
      const h = heroEl.offsetHeight;
      const op = Math.max(0, 1 - s / (h * 0.35));
      lbT.style.opacity = op;
      lbB.style.opacity = op;
      document.getElementById('nav').classList.toggle('scrolled', s > 60);
    }, { passive: true });

    /* ── DUST ── */
    const canvas = document.getElementById('dustCanvas');
    const ctx = canvas.getContext('2d');
    let particles = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    for (let i = 0; i < 50; i++) {
      particles.push({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        r: Math.random() * 0.8 + 0.2,
        vy: -(Math.random() * 0.1 + 0.02),
        vx: (Math.random() - 0.5) * 0.05,
        a: Math.random() * 0.06 + 0.01,
        ph: Math.random() * Math.PI * 2
      });
    }

    function drawDust() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const t = Date.now() * 0.001;
      particles.forEach(p => {
        p.x += p.vx + Math.sin(t + p.ph) * 0.03;
        p.y += p.vy;
        if (p.y < -10) { p.y = canvas.height + 10; p.x = Math.random() * canvas.width; }
        ctx.beginPath();
        ctx.arc(p.x, p.y, Math.max(0.1, p.r), 0, Math.PI * 2);
        ctx.fillStyle = `rgba(201,168,76,${p.a})`;
        ctx.fill();
      });
      requestAnimationFrame(drawDust);
    }
    drawDust();

    /* ── TERMINAL TYPING ── */
    const termLines = document.querySelectorAll('#termBody .line');
    termLines.forEach((line, i) => {
      setTimeout(() => {
        line.classList.add('vis');
      }, 3000 + i * 400);
    });

    /* ── HUD CLOCKS ── */
    const clockEl = document.getElementById('clock');
    const uptimeEl = document.getElementById('uptime');
    const t0 = Date.now();

    (function tick() {
      const d = Date.now() - t0;
      const h = String(Math.floor(d / 3600000)).padStart(2, '0');
      const m = String(Math.floor((d % 3600000) / 60000)).padStart(2, '0');
      const s = String(Math.floor((d % 60000) / 1000)).padStart(2, '0');
      const now = new Date();
      const nh = String(now.getHours()).padStart(2, '0');
      const nm = String(now.getMinutes()).padStart(2, '0');
      const ns = String(now.getSeconds()).padStart(2, '0');
      clockEl.textContent = `${nh}:${nm}:${ns}`;
      uptimeEl.textContent = `${h}:${m}:${s}`;
      requestAnimationFrame(tick);
    })();

    /* ── SCROLL REVEALS ── */
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) e.target.classList.add('v');
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.rv, .sdiv').forEach(el => obs.observe(el));
  </script>
