</body>
</html>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --blue: #4aaeff;
    --white: #f5f5f5;
    --dark: #080808;
    --mid: #111;
    --border: #1e1e1e;
    --muted: #555;
    --teal: #4dcfcf;
  }

  body {
    background: var(--dark);
    color: var(--white);
    font-family: 'Syne', sans-serif;
    overflow-x: hidden;
  }

  .code-font { font-family: 'JetBrains Mono', monospace; }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 4rem;
    background: linear-gradient(to bottom, rgba(8,8,8,0.95), transparent);
    border-bottom: 1px solid transparent;
  }

  .nav-logo {
    font-weight: 800;
    color: var(--white);
    text-decoration: none;
    letter-spacing: 0.1em;
  }

  .nav-links { display: flex; gap: 2rem; }

  .nav-link {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.3s;
    font-family: 'JetBrains Mono', monospace;
  }

  .nav-link.active { color: var(--blue); }
  .nav-link:hover { color: var(--white); }

  /* HERO */
  #hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 4rem 4rem;
    overflow: hidden;
    gap: 4rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(74,174,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74,174,255,0.04) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  .glow {
    position: absolute;
    top: 20%;
    left: 30%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(74,174,255,0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    flex: 1;
    opacity: 0;
    transform: translateY(30px);
    animation: heroIn 0.8s 0.2s forwards;
  }

  @keyframes heroIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-label {
    font-size: 0.85rem;
    color: var(--blue);
    margin-bottom: 1.5rem;
    opacity: 0.8;
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }

  .outline {
    -webkit-text-stroke: 2px var(--white);
    color: transparent;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--muted);
    margin-bottom: 2.5rem;
    letter-spacing: 0.05em;
  }

  .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    padding: 0.8rem 2rem;
    background: var(--white);
    color: var(--dark);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    transition: background 0.3s;
  }

  .btn-primary:hover { background: var(--blue); color: var(--dark); }

  .btn-secondary {
    padding: 0.8rem 2rem;
    border: 1px solid var(--border);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    transition: border-color 0.3s, color 0.3s;
  }

  .btn-secondary:hover { border-color: var(--white); color: var(--white); }

  /* TERMINAL */
  .terminal-widget {
    position: relative;
    z-index: 2;
    background: #0d0d0d;
    border: 1px solid var(--border);
    border-radius: 8px;
    width: 380px;
    flex-shrink: 0;
    opacity: 0;
    transform: translateY(30px);
    animation: heroIn 0.8s 0.5s forwards;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }

  .terminal-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    margin-left: 0.5rem;
  }

  .terminal-body {
    padding: 1.2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    line-height: 2;
  }

  .t-green { color: #28c840; }
  .t-blue { color: var(--blue); }
  .t-white { color: #ccc; }
  .t-teal { color: var(--teal); }

  .blink {
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%,100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* SECTIONS */
  section:not(#hero) {
    padding: 8rem 4rem;
    border-top: 1px solid var(--border);
  }

  .section-label {
    font-size: 0.75rem;
    color: var(--blue);
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 3rem;
  }

  /* ABOUT */
  .about-text {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.9;
    max-width: 600px;
    margin-bottom: 3rem;
  }

  .about-stats {
    display: flex;
    gap: 4rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stat-num {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--white);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .skill-card {
    background: var(--dark);
    padding: 2.5rem;
    transition: background 0.3s;
  }

  .skill-card:hover { background: var(--mid); }

  .skill-icon {
    display: block;
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--blue);
  }

  .skill-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .skill-card p {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* PROJECTS */
  .projects-list {
    display: flex;
    flex-direction: column;
  }

  .project-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 2rem;
    align-items: start;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.3s;
  }

  .project-item:hover {
    padding-left: 1rem;
    margin-left: -1rem;
    background: var(--mid);
    padding-right: 1rem;
  }

  .project-num {
    font-size: 0.75rem;
    color: var(--muted);
    padding-top: 0.3rem;
  }

  .project-info h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .project-info p {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 500px;
  }

  .project-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-tags span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .project-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .project-link {
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    transition: color 0.3s;
  }

  .project-link:hover { color: var(--blue); }

  /* CONTACT */
  .contact-email {
    display: block;
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: var(--blue);
    text-decoration: none;
    margin-bottom: 2rem;
    font-family: 'JetBrains Mono', monospace;
    transition: opacity 0.3s;
  }

  .contact-email:hover { opacity: 0.7; }

  .contact-socials {
    display: flex;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .contact-socials a {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }

  .contact-socials a:hover { color: var(--white); }

  .footer-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .footer-line a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-line a:hover { color: var(--white); }

  /* REVEAL ANIMATION */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s, transform 0.8s;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>