        <p>HTML · CSS · JavaScript · React · Astro · Tailwind</p>
      </div>
      <div class="skill-card">
        <span class="skill-icon">⚙</span>
        <h3>Backend</h3>
        <p>Node.js · Express · REST APIs · PostgreSQL · MongoDB</p>
