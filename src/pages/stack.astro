      <div class="terminal-body">
        <p><span class="t-green">→</span> <span class="t-blue">whoami</span></p>
        <p class="t-white">Suchintha Hettiarachchi</p>
        <p><span class="t-green">→</span> <span class="t-blue">skills --list</span></p>
        <p class="t-white">[ HTML, CSS, JS, React, Astro, Node ]</p>
        <p><span class="t-green">→</span> <span class="t-blue">status</span></p>
        <p class="t-teal">Available for work <span class="blink">_</span></p>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="reveal">
    <div class="about-inner">
      <p class="section-label code-font">// 001 — about</p>
      <h2 class="section-title">THE DEVELOPER<br/>BEHIND THE CODE</h2>
      <p class="about-text">I'm a web developer and creative from Sri Lanka who loves building clean, functional, and beautiful digital experiences. I bridge the gap between design and engineering — writing code that works as well as it looks.</p>
      <div class="about-stats">
        <div class="stat">
          <span class="stat-num">10+</span>
          <span class="stat-label">Projects Built</span>
        </div>
        <div class="stat">
          <span class="stat-num">2+</span>
          <span class="stat-label">Years Experience</span>
        </div>
        <div class="stat">
          <span class="stat-num">∞</span>
          <span class="stat-label">Lines of Code</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="reveal">
    <p class="section-label code-font">// 002 — skills</p>
    <h2 class="section-title">TECH STACK</h2>
