---
// Standalone Web Dev Page - Light Editorial Theme
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stack — Suchintha Hettiarachchi</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400&family=Syne:wght@400;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    ::selection { background: var(--teal); color: #fff; }

    :root {
      --amber: #b08930; --amber-dim: #d4c090;
      --teal: #1a7a7a; --teal-dim: #90c4c4; --teal-glow: rgba(26, 122, 122, 0.15);
      --rust: #8a4a2a;
      --dark: #f5f3ef; --surface: #eae8e4;
      --text: #121010; --muted: #8a8580;
      --border: #dcd8d0; --border-hi: #c0bcb4;
    }

    html { scroll-behavior: smooth; scrollbar-width: thin; scrollbar-color: var(--border) var(--dark); }
    body { background: var(--dark); color: var(--text); font-family: 'Syne', sans-serif; overflow-x: hidden; cursor: none; }

    .prologue { position: fixed; inset: 0; z-index: 200; background: var(--dark); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; transition: opacity 0.8s ease; }
    .prologue.out { opacity: 0; pointer-events: none; }
    .prologue-text { font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; letter-spacing: 0.5em; color: var(--teal); opacity: 0; animation: pIn 0.5s 0.2s forwards; }
    .prologue-line { width: 0; height: 1px; background: var(--teal); animation: pLine 0.8s 0.5s forwards; }
    @keyframes pIn { to { opacity: 1; } } @keyframes pLine { to { width: 60px; } }

    .cur-dot { position: fixed; width: 6px; height: 6px; background: var(--teal); border-radius: 50%; pointer-events: none; z-index: 9999; }
    .cur-ring { position: fixed; width: 34px; height: 34px; border: 1px solid var(--teal-dim); border-radius: 50%; pointer-events: none; z-index: 9998; transition: width 0.3s, height 0.3s, border-color 0.3s; will-change: transform; }
    .cur-ring.h { width: 54px; height: 54px; border-color: var(--teal); }

    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 1.8rem 4rem; transition: all 0.4s; }
    nav.scrolled { padding: 1.2rem 4rem; background: rgba(245,243,239,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
    .nav-logo { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; color: var(--text); text-decoration: none; letter-spacing: 0.2em; }
    .nav-links { display: flex; gap: 2.5rem; }
    .nav-link { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.2em; text-decoration: none; color: var(--muted); transition: color 0.3s; position: relative; }
    .nav-link.active { color: var(--teal); }
    .nav-link::before { content: ''; position: absolute; top: 50%; left: -0.8rem; width: 2px; height: 0; background: var(--teal); transform: translateY(-50%); transition: height 0.3s; }
    .nav-link.active::before { height: 100%; } .nav-link:hover { color: var(--text); }

    .lb { position: fixed; left: 0; right: 0; height: 7vh; background: var(--dark); z-index: 45; pointer-events: none; transition: opacity 0.6s; }
    .lb-t { top: 0; } .lb-b { bottom: 0; }

    #hero { position: relative; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .dev-grid-bg { position: absolute; inset: 0; z-index: 0; background-image: linear-gradient(rgba(26,122,122,0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(26,122,122,0.12) 1px, transparent 1px); background-size: 40px 40px; transform: perspective(500px) rotateX(60deg) translateY(50px) scale(2); opacity: 0.6; mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%); }
    .hero-vig { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 50%, transparent 20%, rgba(245,243,239,0.9) 100%); z-index: 1; }
    .hero-grad { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(245,243,239,0.6) 0%, rgba(245,243,239,0) 35%, rgba(245,243,239,0.4) 75%, rgba(245,243,239,1) 100%); z-index: 1; }
    .hero-ambient { position: absolute; top: 30%; left: 45%; width: 50vw; height: 50vw; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(26,122,122,0.06) 0%, transparent 70%); z-index: 1; pointer-events: none; }
    #dustCanvas { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
    .grain { position: absolute; inset: -50%; width: 200%; height: 200%; opacity: 0.025; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); background-size: 256px; animation: gShift 0.4s steps(2) infinite; pointer-events: none; z-index: 3; filter: invert(1); }
    @keyframes gShift { 0% { transform: translate(0,0); } 50% { transform: translate(-2px,2px); } 100% { transform: translate(1px,-1px); } }
    .hero-inv { position: absolute; font-family: 'JetBrains Mono', monospace; font-size: clamp(4rem, 12vw, 10rem); letter-spacing: 0.1em; color: rgba(0,0,0,0.025); z-index: 1; pointer-events: none; user-select: none; top: 15%; }

    .hero-content { position: relative; z-index: 4; text-align: center; padding: 2rem; }
    .hero-label { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.5em; color: var(--teal); margin-bottom: 2rem; opacity: 0; transform: translateY(15px); animation: fUp 0.8s 2.3s forwards; }
    .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(5rem, 14vw, 13rem); line-height: 0.85; letter-spacing: 0.02em; margin-bottom: 2rem; opacity: 0; transform: translateY(25px); animation: fUp 1s 2.5s forwards; }
    .hero-title .l2 { color: var(--teal); position: relative; display: inline-block; }
    .hero-title .l2::after { content: ''; position: absolute; bottom: 0.05em; left: 0; width: 100%; height: 0.08em; background: var(--teal); opacity: 0.3; transform-origin: left; transform: scaleX(0); animation: lnGrow 0.8s 3.1s forwards; }
    @keyframes lnGrow { to { transform: scaleX(1); } }
    .hero-sub { font-size: 0.9rem; color: var(--muted); letter-spacing: 0.2em; margin-bottom: 3rem; opacity: 0; transform: translateY(15px); animation: fUp 0.8s 2.8s forwards; }
    .hero-btn { display: inline-block; padding: 0.85rem 2.8rem; border: 1px solid var(--teal); color: var(--teal); text-decoration: none; font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.3em; position: relative; overflow: hidden; transition: color 0.4s, border-color 0.4s; opacity: 0; transform: translateY(15px); animation: fUp 0.8s 3s forwards; }
    .hero-btn::before { content: ''; position: absolute; inset: 0; background: var(--teal); transform: scaleX(0); transform-origin: left; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); z-index: -1; }
    .hero-btn:hover { color: #fff; border-color: var(--teal); } .hero-btn:hover::before { transform: scaleX(1); }
    @keyframes fUp { to { opacity: 1; transform: translateY(0); } }

    .hud { position: absolute; z-index: 46; font-family: 'JetBrains Mono', monospace; pointer-events: none; }
    .hud-fr { top: calc(7vh + 1.5rem); right: 4rem; text-align: right; }
    .hud-fr .hl { font-size: 0.45rem; letter-spacing: 0.3em; color: var(--muted); }
    .hud-fr .nm { font-size: 0.8rem; color: var(--teal-dim); letter-spacing: 0.1em; }
    .hud-cl { bottom: calc(7vh + 1.5rem); left: 4rem; }
    .hud-cl .tm { font-size: 0.75rem; color: var(--muted); letter-spacing: 0.15em; }
    .hud-snd { bottom: calc(7vh + 1.5rem); right: 4rem; pointer-events: all; cursor: none; display: flex; align-items: center; gap: 0.5rem; }
    .hud-snd span { font-size: 0.5rem; letter-spacing: 0.3em; color: var(--muted); transition: color 0.3s; }
    .hud-snd .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--muted); transition: background 0.3s; }
    .hud-snd.on .dot { background: var(--teal); } .hud-snd.on span { color: var(--teal); }

    .scroll-hint { position: absolute; bottom: calc(7vh + 1.5rem); left: 50%; transform: translateX(-50%); z-index: 46; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
    .scroll-hint span { font-family: 'JetBrains Mono', monospace; font-size: 0.5rem; letter-spacing: 0.4em; color: var(--muted); }
    .scroll-bar { width: 1px; height: 36px; background: var(--border); position: relative; overflow: hidden; }
    .scroll-bar::after { content: ''; position: absolute; top: -100%; left: 0; width: 100%; height: 100%; background: var(--teal); animation: sPulse 2s ease-in-out infinite; }
    @keyframes sPulse { 0% { top: -100%; } 40% { top: 100%; } 100% { top: 100%; } }

    .rv { opacity: 0; transform: translateY(40px); transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
    .rv.v { opacity: 1; transform: translateY(0); }
    .rv-d1 { transition-delay: 0.1s; } .rv-d2 { transition-delay: 0.2s; } .rv-d3 { transition-delay: 0.3s; }

    .sdiv { height: 1px; background: var(--border); position: relative; overflow: hidden; }
    .sdiv::after { content: ''; position: absolute; top: 0; left: 0; height: 100%; width: 0; background: var(--teal); opacity: 0.4; transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .sdiv.v::after { width: 100%; }

    .sec-glow { position: absolute; border-radius: 50%; pointer-events: none; z-index: 0; filter: blur(80px); }
    .wm { position: absolute; font-family: 'JetBrains Mono', monospace; font-size: clamp(8rem, 16vw, 18rem); color: rgba(0,0,0,0.02); line-height: 1; pointer-events: none; user-select: none; }
    .wm-ab { top: 8rem; right: 4rem; } .wm-wk { top: 5rem; right: 4rem; } .wm-ct { top: 8rem; right: 4rem; }

    #about { min-height: 100vh; display: flex; align-items: center; padding: 12rem 4rem; position: relative; background: var(--surface); }
    #about .sec-glow { top: 20%; right: 10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(26,122,122,0.06) 0%, transparent 70%); }
    .about-inner { max-width: 750px; position: relative; z-index: 1; }
    .about-inner::before { content: ''; position: absolute; left: -2rem; top: 0; width: 2px; height: 0; background: linear-gradient(to bottom, var(--teal), var(--amber-dim)); transition: height 1s 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .about-inner.v::before { height: 100%; }
    .s-label { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.4em; color: var(--teal); margin-bottom: 2.5rem; display: flex; align-items: center; gap: 0.8rem; }
    .s-label::after { content: ''; width: 30px; height: 1px; background: var(--teal-dim); }
    .about-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6rem); line-height: 0.95; letter-spacing: 0.02em; margin-bottom: 2.5rem; }
    .about-title em { font-style: normal; color: var(--teal); }
    .about-text { font-size: 1rem; line-height: 2; color: var(--muted); max-width: 550px; }
    .about-stats { display: flex; gap: 4rem; margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--border); }
    .stat { display: flex; flex-direction: column; }
    .stat-n { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; line-height: 1; }
    .stat-n.c1 { color: var(--teal); } .stat-n.c2 { color: var(--amber); } .stat-n.c3 { color: var(--rust); }
    .stat-l { font-family: 'JetBrains Mono', monospace; font-size: 0.5rem; letter-spacing: 0.25em; color: var(--muted); margin-top: 0.4rem; text-transform: uppercase; }

    /* ── NEW PREMIUM WORK SECTION ── */
    #work { padding: 10rem 4rem; position: relative; background: var(--dark); }
    .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 4rem; position: relative; z-index: 1; }
    
    /* Premium Card Style */
    .work-item {
      display: block; text-decoration: none; color: var(--text);
      background: #ffffff; /* Pure white card */
      border-radius: 16px; /* Rounded corners */
      overflow: hidden; /* Clips image nicely */
      box-shadow: 0 10px 40px rgba(0,0,0,0.04); /* Soft premium shadow */
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
    }
    .work-item:hover {
      transform: translateY(-8px); /* Lifts up on hover */
      box-shadow: 0 20px 60px rgba(0,0,0,0.08); /* Deeper shadow on hover */
    }
    .work-item.large { grid-column: 1 / -1; }
    
    .work-thumb { 
      width: 100%; 
      aspect-ratio: 16/9; 
      position: relative; 
      overflow: hidden; 
      background: #f0f0f0;
    }
    .work-item.large .work-thumb { aspect-ratio: 21/9; }
    
    .wt-bg { 
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); 
    }
    .work-item:hover .wt-bg { transform: scale(1.05); } /* Smooth image zoom */
    
    /* Removed the hard overlays and play buttons for a cleaner agency look */
    .wt-ov { display: none; }
    .wt-play { display: none; }
    .wt-fr { display: none; }
    
    .work-info { 
      padding: 1.5rem 1.8rem; 
      border-top: 1px solid #f0f0f0; 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
    }
    .work-info h3 { 
      font-size: 1.1rem; 
      font-weight: 700; 
      transition: color 0.3s; 
    }
    .work-item:hover .work-info h3 { color: var(--teal); }
    
    .work-tag { 
      font-family: 'JetBrains Mono', monospace; 
      font-size: 0.6rem; 
      letter-spacing: 0.1em; 
      color: var(--muted); 
      background: var(--surface); 
      padding: 0.3rem 0.6rem; 
      border-radius: 4px; 
    }

    #contact { min-height: 85vh; display: flex; flex-direction: column; justify-content: center; padding: 12rem 4rem 4rem; position: relative; background: var(--surface); }
    #contact .sec-glow { bottom: 10%; left: 20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(26,122,122,0.04) 0%, transparent 70%); }
    .contact-inner { margin-bottom: 5rem; position: relative; z-index: 1; }
    .contact-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 7vw, 6.5rem); line-height: 0.95; letter-spacing: 0.02em; margin-bottom: 2.5rem; }
    .contact-email { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: clamp(0.7rem, 1.6vw, 0.95rem); color: var(--teal); text-decoration: none; padding-bottom: 0.5rem; border-bottom: 1px solid var(--teal-dim); margin-bottom: 2.5rem; transition: all 0.3s; word-break: break-all; }
    .contact-email:hover { border-color: var(--teal); text-shadow: 0 0 25px var(--teal-glow); }
    .contact-socials { display: flex; gap: 0; }
    .contact-socials a { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; color: var(--muted); text-decoration: none; padding: 0.5rem 0; margin-right: 2.5rem; position: relative; transition: color 0.3s; }
    .contact-socials a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 1px; background: var(--teal); transition: width 0.3s; }
    .contact-socials a:hover { color: var(--text); } .contact-socials a:hover::after { width: 100%; }
    .footer-line { display: flex; justify-content: space-between; align-items: center; padding-top: 2.5rem; margin-top: auto; border-top: 1px solid var(--border); font-family: 'JetBrains Mono', monospace; font-size: 0.5rem; color: var(--muted); letter-spacing: 0.1em; position: relative; z-index: 1; }
    .footer-line a { color: var(--muted); text-decoration: none; transition: color 0.3s; } .footer-line a:hover { color: var(--teal); }

    @media (max-width: 768px) {
      nav { padding: 1.2rem 1.5rem; } nav.scrolled { padding: 1rem 1.5rem; } .nav-links { gap: 1.5rem; }
      .hud-fr, .hud-cl, .hud-snd { display: none; } .lb { height: 4vh; } #about { padding: 8rem 1.5rem; }
      .wm { display: none; } #work { padding: 6rem 1.5rem; } #contact { padding: 8rem 1.5rem 2rem; }
      .work-grid { grid-template-columns: 1fr; } .about-stats { flex-direction: column; gap: 1.5rem; }
      .contact-socials { flex-direction: column; } .contact-socials a { margin-right: 0; margin-bottom: 0.5rem; }
      .footer-line { flex-direction: column; gap: 0.75rem; text-align: center; } .cur-dot, .cur-ring { display: none; }
      body { cursor: auto; } .hero-inv { display: none; }
    }
  </style>
</head>
<body>
  <div class="prologue" id="prologue"><span class="prologue-text">SYS.INIT</span><div class="prologue-line"></div></div>
  <div class="cur-dot" id="cDot"></div><div class="cur-ring" id="cRing"></div>
  <div class="lb lb-t" id="lbT"></div><div class="lb lb-b" id="lbB"></div>

  <nav id="nav"><a href="/" class="nav-logo">SH</a><div class="nav-links"><a href="/frame" class="nav-link">◉ Frame</a><a href="/stack" class="nav-link active">&lt;/&gt; Stack</a></div></nav>

  <section id="hero">
    <div class="dev-grid-bg"></div>
    <div class="hero-vig"></div><div class="hero-grad"></div><div class="hero-ambient"></div><canvas id="dustCanvas"></canvas><div class="grain"></div><div class="hero-inv">SYS.ROOT</div>
    <div class="hud hud-fr"><div class="hl">LINES</div><div class="nm" id="lineCount">000000</div></div>
    <div class="hud hud-cl"><span class="tm" id="clock">00:00:00</span></div>
    <div class="hud hud-snd" id="sndToggle"><div class="dot"></div><span>LOGS</span></div>
    <div class="hero-content">
      <p class="hero-label">&gt; WEB_PORTFOLIO — INITIALIZED</p>
      <h1 class="hero-title">ARCHITECTING<br/><span class="l2">THE WEB</span></h1>
      <p class="hero-sub">Engineering clean, scalable digital experiences.</p>
      <a href="#work" class="hero-btn">VIEW STACK ↓</a>
    </div>
    <div class="scroll-hint"><span>SCROLL</span><div class="scroll-bar"></div></div>
  </section>
  <div class="sdiv"></div>

  <section id="about"><div class="sec-glow"></div><div class="wm wm-ab">001</div>
    <div class="about-inner rv">
      <div class="s-label">◆ 001 — ABOUT</div>
      <h2 class="about-title">A DEVELOPER<br/>& <em>ENGINEER</em></h2>
      <p class="about-text">I build interfaces that live between logic and aesthetics — the quiet structure behind a seamless interaction, the architecture that scales when it matters. Focused on modern frontend stacks, performant systems, and sharp user experiences.</p>
      <div class="about-stats">
        <div class="stat"><div class="stat-n c1">50+</div><div class="stat-l">Projects</div></div>
        <div class="stat"><div class="stat-n c2">4+</div><div class="stat-l">Years</div></div>
        <div class="stat"><div class="stat-n c3">15+</div><div class="stat-l">Technologies</div></div>
      </div>
    </div>
  </section>
  <div class="sdiv"></div>

  <section id="work">
    <div class="wm wm-wk">002</div>
    <div class="s-label rv" style="position:relative;z-index:1;">◆ 002 — WEB PROJECTS</div>
    <div class="work-grid">
      
      <!-- REAL PROJECT: Harith Engineering -->
      <a href="https://harithengineering.com/" target="_blank" class="work-item large rv">
        <div class="work-thumb">
          <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1600&q=80" alt="Harith Engineering" class="wt-bg" />
        </div>
        <div class="work-info">
          <h3>Harith Engineering</h3>
          <span class="work-tag">React / Tailwind / Vite</span>
        </div>
      </a>

      <a href="#" class="work-item rv rv-d1">
        <div class="work-thumb">
          <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="Project 2" class="wt-bg" />
        </div>
        <div class="work-info">
          <h3>Fluid Commerce Platform</h3>
          <span class="work-tag">React / Node.js</span>
        </div>
      </a>

      <a href="#" class="work-item rv rv-d2">
        <div class="work-thumb">
          <img src="https://images.unsplash.com/photo-1555949963-aa79dcee981c?auto=format&fit=crop&w=800&q=80" alt="Project 3" class="wt-bg" />
        </div>
        <div class="work-info">
          <h3>Syne Portfolio Engine</h3>
          <span class="work-tag">Astro / Three.js</span>
        </div>
      </a>

      <a href="#" class="work-item rv rv-d3">
        <div class="work-thumb">
          <img src="https://images.unsplash.com/photo-1618477388954-7852f32655ec?auto=format&fit=crop&w=800&q=80" alt="Project 4" class="wt-bg" />
        </div>
        <div class="work-info">
          <h3>DataSync REST API</h3>
          <span class="work-tag">Python / FastAPI</span>
        </div>
      </a>

    </div>
  </section>
  <div class="sdiv"></div>

  <section id="contact"><div class="sec-glow"></div><div class="wm wm-ct">003</div>
    <div class="contact-inner">
      <p class="s-label rv">◆ 003 — CONNECT</p>
      <h2 class="contact-title rv rv-d1">LET'S BUILD<br/>SOMETHING</h2>
      <a href="mailto:Suchinthashettiarachchi@gmail.com" class="contact-email rv rv-d2">Suchinthashettiarachchi@gmail.com</a>
      <div class="contact-socials rv rv-d3"><a href="https://github.com/">GitHub</a><a href="https://www.linkedin.com/">LinkedIn</a><a href="https://twitter.com/">Twitter/X</a></div>
    </div>
    <div class="footer-line"><span>© 2026 Suchintha Hettiarachchi</span><a href="/">← Back to Home</a></div>
  </section>
</body>
<script>
  document.body.style.overflow = 'hidden'; const prologue = document.getElementById('prologue');
  function endPrologue() { prologue.classList.add('out'); document.body.style.overflow = ''; setTimeout(() => { prologue.style.display = 'none'; }, 800); }
  setTimeout(endPrologue, 3000);
  const cDot = document.getElementById('cDot'); const cRing = document.getElementById('cRing'); let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; cDot.style.left = mx - 3 + 'px'; cDot.style.top = my - 3 + 'px'; });
  (function ringLoop() { rx += (mx - rx) * 0.1; ry += (my - ry) * 0.1; cRing.style.left = rx - 17 + 'px'; cRing.style.top = ry - 17 + 'px'; requestAnimationFrame(ringLoop); })();
  document.querySelectorAll('a, .work-thumb, .hud-snd').forEach(el => { el.addEventListener('mouseenter', () => cRing.classList.add('h')); el.addEventListener('mouseleave', () => cRing.classList.remove('h')); });
  const lbT = document.getElementById('lbT'); const lbB = document.getElementById('lbB'); const heroEl = document.getElementById('hero');
  window.addEventListener('scroll', () => { const s = window.scrollY; const h = heroEl.offsetHeight; const op = Math.max(0, 1 - s / (h * 0.4)); lbT.style.opacity = op; lbB.style.opacity = op; document.getElementById('nav').classList.toggle('scrolled', s > 60); }, { passive: true });
  const canvas = document.getElementById('dustCanvas'); const ctx = canvas.getContext('2d'); let particles = [];
  function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; } resizeCanvas(); window.addEventListener('resize', resizeCanvas);
  const dustColors = [ [26, 122, 122], [176, 137, 48], [120, 110, 100], [26, 82, 82] ];
  for (let i = 0; i < 60; i++) { const big = Math.random() < 0.08; const col = dustColors[Math.floor(Math.random() * dustColors.length)]; particles.push({ x: Math.random() * window.innerWidth, y: Math.random() * window.innerHeight, r: big ? (Math.random() * 1.8 + 1) : (Math.random() * 0.9 + 0.2), vy: -(Math.random() * 0.12 + 0.03), vx: (Math.random() - 0.5) * 0.06, a: big ? (Math.random() * 0.2 + 0.1) : (Math.random() * 0.15 + 0.05), ph: Math.random() * Math.PI * 2, col: col }); }
  function drawDust() { ctx.clearRect(0, 0, canvas.width, canvas.height); const t = Date.now() * 0.001; particles.forEach(p => { p.x += p.vx + Math.sin(t + p.ph) * 0.04; p.y += p.vy; if (p.y < -10) { p.y = canvas.height + 10; p.x = Math.random() * canvas.width; } if (p.x < -10) p.x = canvas.width + 10; if (p.x > canvas.width + 10) p.x = -10; ctx.beginPath(); ctx.arc(p.x, p.y, Math.max(0.1, p.r), 0, Math.PI * 2); ctx.fillStyle = `rgba(${p.col[0]},${p.col[1]},${p.col[2]},${p.a})`; ctx.fill(); }); requestAnimationFrame(drawDust); } drawDust();
  const lineEl = document.getElementById('lineCount'); let lineNum = 0; setInterval(() => { lineNum += Math.floor(Math.random() * 5) + 1; lineEl.textContent = String(lineNum).padStart(6, '0'); }, 1000 / 24);
  const clockEl = document.getElementById('clock'); const t0 = Date.now(); (function tick() { const d = Date.now() - t0; const h = String(Math.floor(d / 3600000)).padStart(2, '0'); const m = String(Math.floor((d % 3600000) / 60000)).padStart(2, '0'); const s = String(Math.floor((d % 60000) / 1000)).padStart(2, '0'); clockEl.textContent = `${h}:${m}:${s}`; requestAnimationFrame(tick); })();
  const sndBtn = document.getElementById('sndToggle'); let sndOn = false; sndBtn.addEventListener('click', () => { sndOn = !sndOn; sndBtn.classList.toggle('on', sndOn); sndBtn.querySelector('span').textContent = sndOn ? 'CLEAR' : 'LOGS'; });
  const obs = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('v'); }); }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }); document.querySelectorAll('.rv, .sdiv').forEach(el => obs.observe(el));
</script>
