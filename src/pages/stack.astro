<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stack — Suchintha Hettiarachchi</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;700&family=Syne:wght@400;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    ::selection { background: var(--amber); color: var(--dark); }

    :root {
      --amber: #c9a84c;
      --amber-dim: #7a6428;
      --amber-glow: rgba(201, 168, 76, 0.1);
      --dark: #050505;
      --surface: #0a0a0a;
      --text: #d4d0c8;
      --muted: #4a4a4a;
      --border: #141414;
      --border-hi: #222;
    }

    html {
      scroll-behavior: smooth;
      scrollbar-width: thin;
      scrollbar-color: var(--amber-dim) var(--dark);
    }

    body {
      background: var(--dark);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      overflow-x: hidden;
      cursor: none;
    }

    .mono { font-family: 'JetBrains Mono', monospace; }

    /* ── PROLOGUE ── */
    .prologue {
      position: fixed; inset: 0;
      z-index: 200;
      background: var(--dark);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      transition: opacity 0.8s ease;
    }
    .prologue.out { opacity: 0; pointer-events: none; }
    .prologue-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      letter-spacing: 0.6em;
      color: var(--amber);
      opacity: 0;
      animation: pIn 0.5s 0.2s forwards;
    }
    .prologue-line {
      width: 0; height: 1px;
      background: var(--amber);
      animation: pLine 0.8s 0.5s forwards;
    }
    @keyframes pIn { to { opacity: 1; } }
    @keyframes pLine { to { width: 60px; } }

    /* ── CURSOR ── */
    .cur-dot {
      position: fixed;
      width: 5px; height: 5px;
      background: var(--amber);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      mix-blend-mode: difference;
    }
    .cur-ring {
      position: fixed;
      width: 32px; height: 32px;
      border: 1px solid rgba(201,168,76,0.25);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transition: width 0.3s, height 0.3s, border-color 0.3s;
    }
    .cur-ring.h { width: 52px; height: 52px; border-color: var(--amber); }

    /* ── LETTERBOX ── */
    .lb {
      position: fixed; left: 0; right: 0;
      height: 5vh;
      background: var(--dark);
      z-index: 45;
      pointer-events: none;
      transition: opacity 0.5s;
    }
    .lb-t { top: 0; }
    .lb-b { bottom: 0; }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 4rem;
      transition: all 0.4s;
    }
    nav.scrolled {
      padding: 1rem 4rem;
      background: rgba(5,5,5,0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.3rem;
      color: var(--text);
      text-decoration: none;
      letter-spacing: 0.2em;
    }
    .nav-links { display: flex; gap: 2.5rem; }
    .nav-link {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      text-decoration: none;
      color: var(--muted);
      transition: color 0.3s;
      position: relative;
    }
    .nav-link.active { color: var(--amber); }
    .nav-link::before {
      content: '';
      position: absolute;
      top: 50%; left: -0.8rem;
      width: 2px; height: 0;
      background: var(--amber);
      transform: translateY(-50%);
      transition: height 0.3s;
    }
    .nav-link.active::before { height: 100%; }
    .nav-link:hover { color: var(--text); }

    /* ── HUD ── */
    .hud {
      position: fixed;
      z-index: 46;
      font-family: 'JetBrains Mono', monospace;
      pointer-events: none;
    }
    .hud-sys {
      top: calc(5vh + 1.2rem); right: 4rem;
      text-align: right;
      font-size: 0.45rem;
      letter-spacing: 0.25em;
      color: var(--muted);
      line-height: 1.8;
    }
    .hud-sys .val { color: var(--amber-dim); }
    .hud-cl {
      bottom: calc(5vh + 1.2rem); left: 4rem;
      font-size: 0.65rem;
      color: var(--muted);
      letter-spacing: 0.15em;
    }

    /* ── HERO ── */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 10rem 4rem 4rem;
      overflow: hidden;
      gap: 4rem;
    }

    .hero-grid {
      position: absolute; inset: 0; z-index: 0;
      background-image:
        linear-gradient(rgba(201,168,76,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201,168,76,0.025) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse at 30% 50%, black 20%, transparent 70%);
      -webkit-mask-image: radial-gradient(ellipse at 30% 50%, black 20%, transparent 70%);
    }

    .hero-glow {
      position: absolute;
      top: 10%; left: 20%;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(201,168,76,0.04) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 0;
    }

    .hero-scan {
      position: absolute; inset: 0; z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }
    .hero-scan::after {
      content: '';
      position: absolute;
      left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(201,168,76,0.06), transparent);
      animation: scanDown 8s linear infinite;
    }
    @keyframes scanDown {
      0% { top: -2px; }
      100% { top: 100%; }
    }

    #dustCanvas {
      position: absolute; inset: 0;
      z-index: 1; pointer-events: none;
    }

    .grain {
      position: absolute; inset: -50%;
      width: 200%; height: 200%;
      opacity: 0.03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 256px;
      animation: gS 0.4s steps(2) infinite;
      pointer-events: none; z-index: 2;
    }
    @keyframes gS {
      0% { transform: translate(0,0); }
      50% { transform: translate(-2px,2px); }
      100% { transform: translate(1px,-1px); }
    }

    .hero-inv {
      position: absolute;
      right: -2rem; top: 50%;
      transform: translateY(-50%) rotate(90deg);
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4rem, 8vw, 8rem);
      letter-spacing: 0.15em;
      color: rgba(201,168,76,0.015);
      z-index: 0; pointer-events: none; user-select: none;
      white-space: nowrap;
    }

    .hero-content {
      position: relative; z-index: 3;
      flex: 1;
    }
    .hero-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.5em;
      color: var(--amber);
      margin-bottom: 2rem;
      opacity: 0;
      transform: translateY(15px);
      animation: fU 0.8s 2.3s forwards;
    }
    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4rem, 10vw, 8rem);
      line-height: 0.88;
      letter-spacing: 0.02em;
      margin-bottom: 1.5rem;
      opacity: 0;
      transform: translateY(25px);
      animation: fU 1s 2.5s forwards;
    }
    .hero-title .outline {
      -webkit-text-stroke: 1.5px var(--text);
      color: transparent;
    }
    .hero-sub {
      font-size: 0.9rem;
      color: var(--muted);
      letter-spacing: 0.15em;
      margin-bottom: 2.5rem;
      opacity: 0;
      transform: translateY(15px);
      animation: fU 0.8s 2.7s forwards;
    }
    .hero-btns {
      display: flex; gap: 1rem; flex-wrap: wrap;
      opacity: 0;
      transform: translateY(15px);
      animation: fU 0.8s 2.9s forwards;
    }
    .btn-p {
      padding: 0.85rem 2.2rem;
      background: var(--amber);
      color: var(--dark);
      text-decoration: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      transition: all 0.3s;
    }
    .btn-p:hover { background: var(--text); }
    .btn-s {
      padding: 0.85rem 2.2rem;
      border: 1px solid var(--border-hi);
      color: var(--muted);
      text-decoration: none;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      transition: all 0.3s;
    }
    .btn-s:hover { border-color: var(--amber-dim); color: var(--amber); }

    @keyframes fU { to { opacity: 1; transform: translateY(0); } }

    /* ── TERMINAL ── */
    .terminal {
      position: relative; z-index: 3;
      background: rgba(8,8,8,0.85);
      border: 1px solid var(--border);
      width: 380px;
      flex-shrink: 0;
      backdrop-filter: blur(4px);
      opacity: 0;
      transform: translateY(25px);
      animation: fU 0.8s 2.6s forwards;
    }
    .term-bar {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.7rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .term-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
    }
    .term-dot.r { background: #ff5f57; }
    .term-dot.y { background: #febc2e; }
    .term-dot.g { background: #28c840; }
    .term-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      color: var(--muted);
      margin-left: 0.5rem;
      letter-spacing: 0.05em;
    }
    .term-body {
      padding: 1.2rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      line-height: 2.2;
    }
    .term-body .line {
      opacity: 0;
    }
    .term-body .line.vis {
      opacity: 1;
      transition: opacity 0.3s;
    }
    .t-prompt { color: var(--amber-dim); }
    .t-cmd { color: var(--amber); }
    .t-out { color: #999; }
    .t-hi { color: var(--amber); }
    .blink { animation: blk 1s infinite; }
    @keyframes blk { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

    .scroll-hint {
      position: absolute;
      bottom: calc(5vh + 1.5rem);
      left: 50%;
      transform: translateX(-50%);
      z-index: 46;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .scroll-hint span {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.45rem;
      letter-spacing: 0.4em;
      color: var(--muted);
    }
    .scroll-bar {
      width: 1px; height: 30px;
      background: var(--border);
      position: relative;
      overflow: hidden;
    }
    .scroll-bar::after {
      content: '';
      position: absolute;
      top: -100%; left: 0;
      width: 100%; height: 100%;
      background: var(--amber);
      animation: sP 2s ease-in-out infinite;
    }
    @keyframes sP {
      0% { top: -100%; }
      40% { top: 100%; }
      100% { top: 100%; }
    }

    /* ── REVEAL ── */
    .rv {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .rv.v { opacity: 1; transform: translateY(0); }
    .rv-d1 { transition-delay: 0.1s; }
    .rv-d2 { transition-delay: 0.2s; }
    .rv-d3 { transition-delay: 0.3s; }
    .rv-d4 { transition-delay: 0.4s; }

    /* ── DIVIDER ── */
    .sdiv {
      height: 1px;
      background: var(--border);
      position: relative;
      overflow: hidden;
    }
    .sdiv::after {
      content: '';
      position: absolute;
      top: 0; left: 0;
      height: 100%; width: 0;
      background: var(--amber);
      opacity: 0.15;
      transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sdiv.v::after { width: 100%; }

    /* ── SECTIONS ── */
    .s-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.4em;
      color: var(--amber);
      margin-bottom: 2.5rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }
    .s-label::after {
      content: '';
      width: 30px; height: 1px;
      background: var(--amber-dim);
    }
    .s-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      line-height: 0.95;
      letter-spacing: 0.02em;
      margin-bottom: 3rem;
    }

    /* ── ABOUT ── */
    #about {
      min-height: 80vh;
      display: flex;
      align-items: center;
      padding: 10rem 4rem;
      position: relative;
    }
    .wm {
      position: absolute;
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(8rem, 16vw, 18rem);
      color: rgba(201,168,76,0.015);
      line-height: 1;
      pointer-events: none; user-select: none;
    }
    .wm-ab { top: 6rem; right: 4rem; }
    .wm-sk { top: 4rem; right: 4rem; }
    .wm-pj { top: 4rem; right: 4rem; }
    .wm-ct { top: 6rem; right: 4rem; }

    .about-inner {
      max-width: 700px;
      position: relative;
    }
    .about-inner::before {
      content: '';
      position: absolute;
      left: -2rem; top: 0;
      width: 2px; height: 0;
      background: var(--amber-dim);
      transition: height 1s 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .about-inner.v::before { height: 100%; }

    .about-text {
      font-size: 1rem;
      line-height: 2;
      color: var(--muted);
      max-width: 520px;
      margin-bottom: 3rem;
    }
    .about-stats {
      display: flex; gap: 4rem;
      padding-top: 3rem;
      border-top: 1px solid var(--border);
    }
    .stat-n {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.5rem;
      color: var(--amber);
      line-height: 1;
    }
    .stat-l {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.45rem;
      letter-spacing: 0.25em;
      color: var(--muted);
      margin-top: 0.4rem;
      text-transform: uppercase;
    }

    /* ── SKILLS ── */
    #skills {
      padding: 10rem 4rem;
      position: relative;
    }
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 4rem;
    }
    .skill-card {
      background: var(--dark);
      padding: 2.5rem 2rem;
      position: relative;
      overflow: hidden;
      transition: background 0.4s;
    }
    .skill-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 2px;
      background: var(--amber);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .skill-card:hover { background: var(--surface); }
    .skill-card:hover::before { transform: scaleX(1); }

    .skill-idx {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.45rem;
      letter-spacing: 0.2em;
      color: var(--amber-dim);
      margin-bottom: 1.5rem;
    }
    .skill-icon {
      font-size: 1.2rem;
      color: var(--amber);
      margin-bottom: 1rem;
      display: block;
    }
    .skill-card h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.3rem;
      letter-spacing: 0.08em;
      margin-bottom: 0.8rem;
    }
    .skill-card p {
      font-size: 0.78rem;
      color: var(--muted);
      line-height: 1.8;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.02em;
    }

    /* ── PROJECTS ── */
    #projects {
      padding: 10rem 4rem;
      position: relative;
    }
    .projects-list { margin-top: 4rem; }
    .project-item {
      display: grid;
      grid-template-columns: 70px 1fr auto;
      gap: 2rem;
      align-items: start;
      padding: 2.5rem 1.5rem;
      border-bottom: 1px solid var(--border);
      position: relative;
      transition: all 0.4s;
    }
    .project-item::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 0;
      background: var(--amber-glow);
      transition: width 0.4s;
    }
    .project-item:hover {
      background: var(--surface);
      margin-left: 0.5rem;
    }
    .project-item:hover::before { width: 2px; }

    .project-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      color: var(--amber-dim);
      padding-top: 0.3rem;
    }
    .project-info h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
      transition: color 0.3s;
    }
    .project-item:hover .project-info h3 { color: var(--amber); }
    .project-info p {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 1rem;
      max-width: 480px;
    }
    .project-tags {
      display: flex; gap: 0.4rem; flex-wrap: wrap;
    }
    .project-tags span {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.6rem;
      border: 1px solid var(--border);
      color: var(--muted);
      transition: border-color 0.3s, color 0.3s;
    }
    .project-item:hover .project-tags span {
      border-color: var(--border-hi);
    }
    .project-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-end;
      padding-top: 0.3rem;
    }
    .project-link {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.3s;
    }
    .project-link:hover { color: var(--amber); }

    /* ── CONTACT ── */
    #contact {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10rem 4rem 4rem;
      position: relative;
    }
    .contact-inner { margin-bottom: 5rem; }
    .contact-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 7vw, 6rem);
      line-height: 0.95;
      letter-spacing: 0.02em;
      margin-bottom: 2.5rem;
    }
    .contact-email {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(0.65rem, 1.5vw, 0.85rem);
      color: var(--amber);
      text-decoration: none;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--amber-dim);
      margin-bottom: 2.5rem;
      transition: all 0.3s;
      word-break: break-all;
    }
    .contact-email:hover {
      border-color: var(--amber);
      text-shadow: 0 0 25px var(--amber-glow);
    }
    .contact-socials { display: flex; gap: 0; }
    .contact-socials a {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.2em;
      color: var(--muted);
      text-decoration: none;
      padding: 0.5rem 0;
      margin-right: 2.5rem;
      position: relative;
      transition: color 0.3s;
    }
    .contact-socials a::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 0; height: 1px;
      background: var(--amber);
      transition: width 0.3s;
    }
    .contact-socials a:hover { color: var(--text); }
    .contact-socials a:hover::after { width: 100%; }

    .footer-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 2.5rem;
      margin-top: auto;
      border-top: 1px solid var(--border);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.45rem;
      color: var(--muted);
      letter-spacing: 0.1em;
    }
    .footer-line a {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.3s;
    }
    .footer-line a:hover { color: var(--amber); }

    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) {
      .skills-grid { grid-template-columns: repeat(2, 1fr); }
      .terminal { width: 320px; }
    }
    @media (max-width: 768px) {
      nav { padding: 1.2rem 1.5rem; }
      nav.scrolled { padding: 1rem 1.5rem; }
      .nav-links { gap: 1.5rem; }
      .hud-sys, .hud-cl { display: none; }
      .lb { height: 3vh; }
      #hero { padding: 8rem 1.5rem 4rem; flex-direction: column; }
